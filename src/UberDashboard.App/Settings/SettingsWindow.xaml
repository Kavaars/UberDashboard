<Window x:Class="UberDashboard.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:platform="clr-namespace:UberDashboard.Application.Platform;assembly=UberDashboard.Application"
        xmlns:controls="clr-namespace:UberDashboard.App.Controls"
        xmlns:theming="clr-namespace:UberDashboard.App.Theming"
        mc:Ignorable="d"
        Title="Opcje i Ustawienia"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Alt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Brush.Surface}" /><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Foreground="{DynamicResource Brush.Text}" FontSize="24" FontWeight="SemiBold" Text="Opcje i Ustawienia" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="{DynamicResource Brush.Text.Muted}"
                 Text="Zmiany są widoczne od razu i zapisują się automatycznie." />
    </StackPanel>

    <TabControl Grid.Row="1"
                Background="Transparent"
                BorderBrush="{DynamicResource Brush.Border}">
      <TabItem Header="Personalizacja">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Wygląd" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Motyw" />
                  <ComboBox Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource ThemedComboBox}"
                            ItemsSource="{Binding ThemeOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}"
                            SelectedItem="{Binding SelectedTheme}" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Kolor akcentu" />
                  <controls:ColorWheel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding AccentColor}" AutomationProperties.Name="AccentColor" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Tło okna" />
                  <controls:ColorWheel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding WindowBackgroundColor}" AutomationProperties.Name="WindowBackgroundColor" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Powierzchnia kart" />
                  <controls:ColorWheel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding SurfaceColor}" AutomationProperties.Name="SurfaceColor" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Powierzchnia pomocnicza" />
                  <controls:ColorWheel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding SurfaceAltColor}" AutomationProperties.Name="SurfaceAltColor" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="5" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Font" />
                  <ComboBox Grid.Row="5" Grid.Column="1"
                            Margin="0,0,0,10"
                            Style="{StaticResource ThemedComboBox}"
                            ItemsSource="{Binding AvailableFonts}"
                            SelectedItem="{Binding SelectedFontFamily}" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="6" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Rozmiar fontu" />
                  <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                    <Slider Minimum="11" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding FontSize, StringFormat={}{0:0} px}" />
                  </StackPanel>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="7" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Promień narożników" />
                  <StackPanel Grid.Row="7" Grid.Column="1">
                    <Slider Minimum="4" Maximum="28" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding CornerRadius, StringFormat={}{0:0} px}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Tapeta i przezroczystość okna" />
                <WrapPanel>
                  <Button Content="Wybierz tapetę…" Command="{Binding ChooseWallpaperCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Wybiera obraz wyświetlany pod panelami i paskami głównego okna." />
                  <Button Content="Usuń tapetę" Command="{Binding RemoveWallpaperCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Usuwa tapetę z aplikacji bez usuwania pliku obrazu." />
                </WrapPanel>
                <TextBlock Text="{Binding WallpaperPath, TargetNullValue=Nie wybrano tapety}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Muted}" />
                <TextBlock Text="Rozmycie tapety" Foreground="{DynamicResource Brush.Text}" Margin="0,10,0,0" />
                <Slider Minimum="0" Maximum="30" Value="{Binding WallpaperBlur}" AutomationProperties.Name="Rozmycie tapety" ToolTip="Rozmywa wyłącznie obraz tapety aplikacji." />
                <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Pokaż pulpit przez tło aplikacji" IsChecked="{Binding TransparentDesktopBackground}" ToolTip="Odsłania okna i pulpit za aplikacją, zachowując krycie tekstu i kontrolek. Tapeta aplikacji jest tymczasowo ukryta." />
                <TextBlock Text="Krycie powierzchni paneli i pasków" Foreground="{DynamicResource Brush.Text}" />
                <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundSurfaceOpacity}" AutomationProperties.Name="Krycie powierzchni paneli i pasków" ToolTip="Zmienia krycie tła paneli nad tapetą aplikacji lub pulpitem, bez zmiany krycia tekstu." />
                <TextBlock Text="Krycie całego okna" Foreground="{DynamicResource Brush.Text}" />
                <Slider Minimum="0.2" Maximum="1" Value="{Binding WindowOpacity}" AutomationProperties.Name="Krycie całego okna" ToolTip="Zmienia krycie całego okna wraz z tekstem i kontrolkami, odsłaniając pulpit." />
                <CheckBox Content="Rozmyj obraz za oknem (Windows 11)" IsChecked="{Binding DesktopBlur}" ToolTip="Włącza systemowy materiał Acrylic. Efekt zależy od wersji Windows oraz systemowego ustawienia przezroczystości." />
              </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Gęstość i zachowanie" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Gęstość interfejsu" />
                  <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Slider Minimum="0.85" Maximum="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding DensityScale}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding DensityScale, StringFormat={}{0:0.00}x}" />
                  </StackPanel>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Odświeżanie pogody" />
                  <StackPanel Grid.Row="1" Grid.Column="1">
                    <Slider Minimum="5" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WeatherRefreshMinutes}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding WeatherRefreshMinutes, StringFormat={}{0} min}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Wyświetlanie">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Tryb pracy okna" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Tryb startowy" />
                  <ComboBox Grid.Row="0" Grid.Column="1"
                            Margin="0,0,0,10"
                            Style="{StaticResource ThemedComboBox}"
                            ItemsSource="{Binding WindowModes}" ItemTemplate="{StaticResource SettingsEnumTemplate}"
                            SelectedItem="{Binding SelectedLaunchMode}" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Monitor dla paska" />
                  <ComboBox Grid.Row="1" Grid.Column="1"
                            Margin="0,0,0,10"
                            Style="{StaticResource ThemedComboBox}"
                            ItemsSource="{Binding Monitors}"
                            SelectedItem="{Binding SelectedMonitor}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.Text}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Krawędź paska" />
                  <ComboBox Grid.Row="2" Grid.Column="1"
                            Margin="0,0,0,10"
                            Style="{StaticResource ThemedComboBox}"
                            ItemsSource="{Binding DockEdges}" ItemTemplate="{StaticResource SettingsEnumTemplate}"
                            SelectedItem="{Binding SelectedDockEdge}" />

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Grubość paska" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                    <Slider Minimum="200" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding DockThickness}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding DockThickness, StringFormat={}{0} px}" />
                  </StackPanel>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Przezroczystość widgetu" />
                  <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                    <Slider IsEnabled="False" ToolTip="Zmiana przezroczystości będzie dostępna po wdrożeniu rzeczywistej warstwy pulpitu." Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding WidgetOpacity}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding WidgetOpacity, StringFormat={}{0:0.00}}" />
                  </StackPanel>

                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="5" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Stan widgetu" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Text="Eksperymentalny: obecnie dostępny jest bezpieczny powrót do zwykłego okna." />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Aplikacja">
        <StackPanel Margin="12">
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Integracja z systemem" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Autostart" />
                <CheckBox Style="{StaticResource ThemedCheckBox}" Grid.Row="0" Grid.Column="1"
                          Content="Uruchamiaj UberDashboard razem z systemem"
                          IsChecked="{Binding StartWithWindows}"
                          ToolTip="Dodaje lub usuwa wpis autostartu bieżącego użytkownika Windows." />

                <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Ikona w zasobniku" />
                <CheckBox Style="{StaticResource ThemedCheckBox}" Grid.Row="1" Grid.Column="1"
                          Content="Pokazuj ikonę w zasobniku systemowym"
                          IsChecked="{Binding EnableTrayIcon}"
                          ToolTip="Włącza ikonę obszaru powiadomień z szybkim przywróceniem okna i poleceniem zakończenia aplikacji." />

                <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Po zamknięciu okna" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          Style="{StaticResource ThemedComboBox}"
                          ItemsSource="{Binding CloseBehaviorOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}"
                          SelectedItem="{Binding SelectedCloseBehavior}"
                          ToolTip="Wybiera reakcję na kliknięcie krzyżyka okna: pełne zakończenie procesu albo ukrycie do zasobnika." />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="PluginsTab" Header="Pluginy">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Panele z pluginów" Style="{StaticResource SettingsSectionTitle}" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Wybierz paczkę .udplugin lub upuść ją na okno. Instaluj wyłącznie pluginy z zaufanego źródła: ich kod działa z uprawnieniami aplikacji." TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Zainstaluj z pliku…" Command="{Binding InstallCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Sprawdza paczkę i udostępnia jej panele w menu Dodaj panel bez restartu."/>
              <Button Content="Anuluj operację" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Przerywa operację przed zatwierdzeniem instalacji lub usunięcia."/>
            </WrapPanel>
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}">
              <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
            </ProgressBar>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Installed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right" Content="Usuń" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" ToolTip="Usuwa kod pluginu. Dane i miejsca paneli pozostają zachowane do ponownej instalacji." AutomationProperties.Name="{Binding Name, StringFormat=Usuń plugin {0}}"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="{Binding Version, StringFormat=Wersja {0}}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock MaxWidth="340" TextWrapping="Wrap" DockPanel.Dock="Left"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.Text.Muted}"
                 Text="{Binding SaveStatus}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Ponów zapis" Command="{Binding RetrySaveCommand}" Style="{StaticResource ToolbarButton}" />
        <Button Command="{Binding ResetDefaultsCommand}"
                Content="Domyślne"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Przywraca domyślne kolory, fonty i tryb pracy okna oraz wraca do bezpiecznego trybu normalnego." />
        <Button Command="{Binding CloseCommand}"
                Content="Zamknij"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Zamyka okno ustawień. Ostatnio zapisane ustawienia pozostają aktywne." />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
