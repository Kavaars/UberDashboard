<Window xmlns:loc="clr-namespace:UberDashboard.App.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:platform="clr-namespace:UberDashboard.Application.Platform;assembly=UberDashboard.Application" xmlns:controls="clr-namespace:UberDashboard.App.Controls" xmlns:theming="clr-namespace:UberDashboard.App.Theming" x:Class="UberDashboard.App.Settings.SettingsWindow" mc:Ignorable="d" Title="{loc:Text Settings}" Style="{DynamicResource ThemedWindow}" Width="860" Height="650" MinWidth="740" MinHeight="520" Background="{DynamicResource Brush.Window.Background}" Foreground="{DynamicResource Brush.Text}" WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource Token.FontFamily}" FontSize="{DynamicResource Token.FontSize.Body}">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Margin" Value="0,2,8,2"/>
      <Setter Property="Width" Value="150"/>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource Token.CornerRadius.S}" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Surface.Alt}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Surface.Alt}"/>
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Foreground="{DynamicResource Brush.Text}" FontSize="20" FontWeight="SemiBold" Text="{loc:Text Settings}" TextWrapping="Wrap"/>
      <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Muted}" Text="{loc:Text ChangesTakeEffectImmediatelyAndSaveAutomatically}" TextWrapping="Wrap"/>
    </StackPanel>
    <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" TabStripPlacement="Left" BorderThickness="0">
      <TabItem Header="{loc:Text Appearance}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text Appearance}" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text Theme}" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding ThemeOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedTheme}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text AccentColor}" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding AccentColor}" AutomationProperties.Name="{loc:Text AccentColor2}" DefaultBrushKey="Brush.Accent"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text WindowBackground}" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding WindowBackgroundColor}" AutomationProperties.Name="{loc:Text WindowBackgroundColor}" DefaultBrushKey="Brush.Window.Background"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text PanelSurface}" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding SurfaceColor}" AutomationProperties.Name="{loc:Text PanelSurfaceColor}" DefaultBrushKey="Brush.Surface"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text AlternateSurface}" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding SurfaceAltColor}" AutomationProperties.Name="{loc:Text AlternateSurfaceColor}" DefaultBrushKey="Brush.Surface.Alt"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="5" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Text CornerRadius}" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="5" Grid.Column="1">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding CornerRadius, StringFormat={}{0:0} px}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="4" Maximum="28" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text CornerRadius2}"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Text TextAndSpacing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Text="{loc:Text Text}" Style="{StaticResource SettingsSectionTitle}" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text Font}" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedFontFamily}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text FontSize}" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding FontSize, StringFormat={}{0:0} px}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="11" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text FontSize2}"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text Spacing}" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text InterfaceDensity}" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding DensityScale, StringFormat={}{0:0.00}x}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0.85" Maximum="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding DensityScale}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text InterfaceDensity2}"/>
                  </DockPanel>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Text PanelSpacing}" VerticalAlignment="Center" Margin="0,0,12,10" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PanelSpacing, StringFormat={}{0:0} px}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="6" Maximum="32" Value="{Binding PanelSpacing}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{loc:Text PanelSpacing}" ToolTip="{loc:Text ChangesTheAppearanceWithoutReducingTheDivider}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Text DividerLine}" VerticalAlignment="Center" Margin="0,0,12,10" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding DividerThickness, StringFormat={}{0:0} px}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="3" Value="{Binding DividerThickness}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{loc:Text DividerLine}" ToolTip="{loc:Text ChangesTheAppearanceWithoutReducingTheDivider}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Text BackgroundAndTransparency}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text WallpaperAndWindowTransparency}" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="{loc:Text ChooseWallpaper}" Command="{Binding ChooseWallpaperCommand}" Style="{StaticResource ToolbarButton}" ToolTip="{loc:Text ChoosesTheImageShownBehindPanelsAnd}"/>
                  <Button Content="{loc:Text RemoveWallpaper}" Command="{Binding RemoveWallpaperCommand}" Style="{StaticResource ToolbarButton}" ToolTip="{loc:Text RemovesTheWallpaperFromTheAppAnd}"/>
                </WrapPanel>
                <TextBlock Text="{Binding WallpaperPath, TargetNullValue=Nie wybrano tapety}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:Text WallpaperBlur}" Foreground="{DynamicResource Brush.Text}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <Slider Minimum="0" Maximum="30" Value="{Binding WallpaperBlur}" AutomationProperties.Name="{loc:Text WallpaperBlur}" ToolTip="{loc:Text BlursTheAppWallpaper}"/>
                <CheckBox Style="{StaticResource ThemedCheckBox}" Content="{loc:Text ShowTheDesktopThroughTheAppBackground}" IsChecked="{Binding TransparentDesktopBackground}" ToolTip="{loc:Text RevealsWindowsAndTheDesktopBehindThe}"/>
                <TextBlock Text="{loc:Text PanelAndBarSurfaceOpacity}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundSurfaceOpacity}" AutomationProperties.Name="{loc:Text PanelAndBarSurfaceOpacity}" ToolTip="{loc:Text ChangesPanelBackgroundOpacityOverTheWallpaper}"/>
                <TextBlock Text="{loc:Text AppContentOpacity}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                <Slider Minimum="0.2" Maximum="1" Value="{Binding WindowOpacity}" AutomationProperties.Name="{loc:Text AppContentOpacity}" ToolTip="{loc:Text ChangesTheOpacityOfTextIconsImages}"/>
                <CheckBox Content="{loc:Text BlurBehindTheWindowWindows11}" IsChecked="{Binding DesktopBlur}" ToolTip="{loc:Text EnablesWindowsAcrylicTheEffectDependsOn}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Text DockAndDisplay}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text WindowBehavior}" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text StartupMode}" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding WindowModes}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedLaunchMode}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text DockDisplay}" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text DockEdge}" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding DockEdges}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedDockEdge}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text DockThickness}" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding DockThickness, StringFormat={}{0} px}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="200" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding DockThickness}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text DockThickness2}"/>
                  </DockPanel>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text WidgetOpacity}" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding WidgetOpacity, StringFormat={}{0:0.00}}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider IsEnabled="False" ToolTip="{loc:Text OpacityAdjustmentWillBeAvailableOnceDesktop}" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding WidgetOpacity}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text WidgetOpacity2}"/>
                  </DockPanel>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="5" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Text WidgetStatus}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Text="{loc:Text ExperimentalTheAppCanSafelyReturnTo}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Text Application}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Text="{loc:Text AppLanguage}" Style="{StaticResource SettingsSectionTitle}"/>
                <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding LanguageOptions}"
                          SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Code" DisplayMemberPath="Name"
                          AutomationProperties.Name="{loc:Text AppLanguage}" HorizontalAlignment="Left" MinWidth="160"/>
                <TextBlock Text="{loc:Text LanguageRestart}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text SystemIntegration}" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text Startup}" TextWrapping="Wrap"/>
                  <CheckBox Style="{StaticResource ThemedCheckBox}" Grid.Row="0" Grid.Column="1" Content="{loc:Text StartUberdashboardWithWindows}" IsChecked="{Binding StartWithWindows}" ToolTip="{loc:Text AddsOrRemovesTheStartupEntryFor}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{loc:Text TrayIcon}" TextWrapping="Wrap"/>
                  <CheckBox Style="{StaticResource ThemedCheckBox}" Grid.Row="1" Grid.Column="1" Content="{loc:Text ShowTheSystemTrayIcon}" IsChecked="{Binding EnableTrayIcon}" ToolTip="{loc:Text AddsANotificationAreaIconWithShortcuts}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Text WhenClosingTheWindow}" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding CloseBehaviorOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedCloseBehavior}" ToolTip="{loc:Text ChoosesWhetherTheCloseButtonQuitsThe}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" BorderThickness="0">
              <StackPanel>
                <TextBlock Text="{loc:Text WeatherData}" Style="{StaticResource SettingsSectionTitle}" TextWrapping="Wrap"/>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Text WeatherRefreshInterval}" TextWrapping="Wrap"/>
                <DockPanel>
                  <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding WeatherRefreshMinutes, StringFormat={}{0} min}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                  <Slider Minimum="5" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WeatherRefreshMinutes}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text WeatherRefreshInterval2}"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Text Integrations}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Margin="8" Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Microsoft To Do"/>
              <TextBlock TextWrapping="Wrap" Margin="0,6,0,12"
                         Text="{loc:Text ConnectAnAccountChooseListsToImport}"/>
              <Button HorizontalAlignment="Left" Content="{loc:Text OpenMicrosoftToDoSetup}" Style="{StaticResource ToolbarButton}" Click="OpenMicrosoftTodo_Click"
                      ToolTip="{loc:Text OpensAccountConfigurationAndMicrosoftToDo}"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="PluginsTab" Header="{loc:Text Plugins}">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{loc:Text PluginPanels}" Style="{StaticResource SettingsSectionTitle}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Text SelectAUdpluginPackageOrDropIt}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="{loc:Text InstallFromFile}" Command="{Binding InstallCommand}" Style="{StaticResource ToolbarButton}" ToolTip="{loc:Text ChecksThePackageAndMakesItsPanels}"/>
              <Button Content="{loc:Text CancelOperation}" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" ToolTip="{loc:Text CancelsBeforeInstallationOrRemovalIsCommitted}"/>
            </WrapPanel>
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource ThemedProgressBar}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Installed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10" BorderThickness="0">
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right" Content="{loc:Text Remove}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" ToolTip="{loc:Text RemovesThePluginCodePanelDataAnd}" AutomationProperties.Name="{Binding Name, StringFormat={loc:Text RemovePlugin}}"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Version, StringFormat={loc:Text Version}}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="158"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Token.CornerRadius.M}">
              <ContentPresenter x:Name="PART_SelectedContentHost" Margin="4" ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
    </TabControl>
    <WrapPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock MaxWidth="260" TextWrapping="Wrap" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding SaveStatus}" Margin="0,0,10,6"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="{loc:Text RetrySave}" Command="{Binding RetrySaveCommand}" Style="{StaticResource ToolbarButton}"/>
        <Button Command="{Binding ResetDefaultsCommand}" Content="{loc:Text RestoreDefaults}" Style="{StaticResource ToolbarButton}" ToolTip="{loc:Text RestoresTheDefaultColorsFontsAndStartup}"/>
        <Button Command="{Binding CloseCommand}" Content="{loc:Text Close}" Style="{StaticResource ToolbarButton}" ToolTip="{loc:Text ClosesSettingsAndKeepsTheLastSaved}"/>
      </StackPanel>
    </WrapPanel>
  </Grid>
</Window>
