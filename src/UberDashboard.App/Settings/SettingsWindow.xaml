<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:platform="clr-namespace:UberDashboard.Application.Platform;assembly=UberDashboard.Application" xmlns:controls="clr-namespace:UberDashboard.App.Controls" xmlns:theming="clr-namespace:UberDashboard.App.Theming" x:Class="UberDashboard.App.Settings.SettingsWindow" mc:Ignorable="d" Title="Ustawienia" Width="860" Height="650" MinWidth="740" MinHeight="520" Background="{DynamicResource Brush.Window.Background}" Foreground="{DynamicResource Brush.Text}" WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource Token.FontFamily}" FontSize="{DynamicResource Token.FontSize.Body}">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Margin" Value="0,2,8,2"/>
      <Setter Property="Width" Value="150"/>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource Token.CornerRadius.S}" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Surface.Alt}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Surface.Alt}"/>
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Foreground="{DynamicResource Brush.Text}" FontSize="20" FontWeight="SemiBold" Text="Ustawienia" TextWrapping="Wrap"/>
      <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Muted}" Text="Zmiany są widoczne od razu i zapisują się automatycznie." TextWrapping="Wrap"/>
    </StackPanel>
    <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" TabStripPlacement="Left" BorderThickness="0">
      <TabItem Header="Wygląd">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Wygląd" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Motyw" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding ThemeOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedTheme}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Kolor akcentu" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding AccentColor}" AutomationProperties.Name="AccentColor" DefaultBrushKey="Brush.Accent"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Tło okna" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding WindowBackgroundColor}" AutomationProperties.Name="WindowBackgroundColor" DefaultBrushKey="Brush.Window.Background"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Powierzchnia kart" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding SurfaceColor}" AutomationProperties.Name="SurfaceColor" DefaultBrushKey="Brush.Surface"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Powierzchnia pomocnicza" TextWrapping="Wrap"/>
                  <controls:CompactColorPicker Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" SelectedColor="{Binding SurfaceAltColor}" AutomationProperties.Name="SurfaceAltColor" DefaultBrushKey="Brush.Surface.Alt"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="5" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Promień narożników" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="5" Grid.Column="1">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding CornerRadius, StringFormat={}{0:0} px}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="4" Maximum="28" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}" VerticalAlignment="Center" AutomationProperties.Name="CornerRadius"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Tekst i odstępy">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Text="Tekst" Style="{StaticResource SettingsSectionTitle}" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Czcionka" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedFontFamily}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Rozmiar fontu" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding FontSize, StringFormat={}{0:0} px}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="11" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" VerticalAlignment="Center" AutomationProperties.Name="FontSize"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Odstępy" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Gęstość interfejsu" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding DensityScale, StringFormat={}{0:0.00}x}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0.85" Maximum="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding DensityScale}" VerticalAlignment="Center" AutomationProperties.Name="DensityScale"/>
                  </DockPanel>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Odstęp paneli" VerticalAlignment="Center" Margin="0,0,12,10" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PanelSpacing, StringFormat={}{0:0} px}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="6" Maximum="32" Value="{Binding PanelSpacing}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Odstęp paneli" ToolTip="Zmienia wygląd bez zmniejszania obszaru chwytania dzielnika." VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Linia podziału" VerticalAlignment="Center" Margin="0,0,12,10" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding DividerThickness, StringFormat={}{0:0} px}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="3" Value="{Binding DividerThickness}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Linia podziału" ToolTip="Zmienia wygląd bez zmniejszania obszaru chwytania dzielnika." VerticalAlignment="Center"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Tło i przezroczystość">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Tapeta i przezroczystość okna" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="Wybierz tapetę…" Command="{Binding ChooseWallpaperCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Wybiera obraz wyświetlany pod panelami i paskami głównego okna."/>
                  <Button Content="Usuń tapetę" Command="{Binding RemoveWallpaperCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Usuwa tapetę z aplikacji bez usuwania pliku obrazu."/>
                </WrapPanel>
                <TextBlock Text="{Binding WallpaperPath, TargetNullValue=Nie wybrano tapety}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="Rozmycie tapety" Foreground="{DynamicResource Brush.Text}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <Slider Minimum="0" Maximum="30" Value="{Binding WallpaperBlur}" AutomationProperties.Name="Rozmycie tapety" ToolTip="Rozmywa wyłącznie obraz tapety aplikacji."/>
                <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Pokaż pulpit przez tło aplikacji" IsChecked="{Binding TransparentDesktopBackground}" ToolTip="Odsłania okna i pulpit za aplikacją, zachowując krycie tekstu i kontrolek. Tapeta aplikacji jest tymczasowo ukryta."/>
                <TextBlock Text="Krycie powierzchni paneli i pasków" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundSurfaceOpacity}" AutomationProperties.Name="Krycie powierzchni paneli i pasków" ToolTip="Zmienia krycie tła paneli nad tapetą aplikacji lub pulpitem, bez zmiany krycia tekstu."/>
                <TextBlock Text="Widoczność treści aplikacji" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                <Slider Minimum="0.2" Maximum="1" Value="{Binding WindowOpacity}" AutomationProperties.Name="Widoczność treści aplikacji" ToolTip="Zmienia widoczność tekstu, ikon, obrazów i kontrolek niezależnie od tła. Domyślnie 100%."/>
                <CheckBox Content="Rozmyj obraz za oknem (Windows 11)" IsChecked="{Binding DesktopBlur}" ToolTip="Włącza systemowy materiał Acrylic. Efekt zależy od wersji Windows oraz systemowego ustawienia przezroczystości."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Pasek i ekran">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Tryb pracy okna" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Tryb startowy" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding WindowModes}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedLaunchMode}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Monitor dla paska" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Krawędź paska" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding DockEdges}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedDockEdge}"/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Grubość paska" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding DockThickness, StringFormat={}{0} px}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="200" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding DockThickness}" VerticalAlignment="Center" AutomationProperties.Name="DockThickness"/>
                  </DockPanel>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Przezroczystość widgetu" TextWrapping="Wrap"/>
                  <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding WidgetOpacity, StringFormat={}{0:0.00}}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider IsEnabled="False" ToolTip="Zmiana przezroczystości będzie dostępna po wdrożeniu rzeczywistej warstwy pulpitu." Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding WidgetOpacity}" VerticalAlignment="Center" AutomationProperties.Name="WidgetOpacity"/>
                  </DockPanel>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="5" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Stan widgetu" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Text="Eksperymentalny: obecnie dostępny jest bezpieczny powrót do zwykłego okna."/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Aplikacja">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <Border Style="{StaticResource SettingsCard}" BorderThickness="0">
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Style="{StaticResource SettingsSectionTitle}" Text="Integracja z systemem" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Autostart" TextWrapping="Wrap"/>
                  <CheckBox Style="{StaticResource ThemedCheckBox}" Grid.Row="0" Grid.Column="1" Content="Uruchamiaj UberDashboard razem z systemem" IsChecked="{Binding StartWithWindows}" ToolTip="Dodaje lub usuwa wpis autostartu bieżącego użytkownika Windows."/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Ikona w zasobniku" TextWrapping="Wrap"/>
                  <CheckBox Style="{StaticResource ThemedCheckBox}" Grid.Row="1" Grid.Column="1" Content="Pokazuj ikonę w zasobniku systemowym" IsChecked="{Binding EnableTrayIcon}" ToolTip="Włącza ikonę obszaru powiadomień z szybkim przywróceniem okna i poleceniem zakończenia aplikacji."/>
                  <TextBlock Foreground="{DynamicResource Brush.Text}" Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Po zamknięciu okna" TextWrapping="Wrap"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding CloseBehaviorOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedCloseBehavior}" ToolTip="Wybiera reakcję na kliknięcie krzyżyka okna: pełne zakończenie procesu albo ukrycie do zasobnika."/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0" BorderThickness="0">
              <StackPanel>
                <TextBlock Text="Dane pogodowe" Style="{StaticResource SettingsSectionTitle}" TextWrapping="Wrap"/>
                <TextBlock Foreground="{DynamicResource Brush.Text}" Margin="0,0,12,0" VerticalAlignment="Center" Text="Odświeżanie pogody" TextWrapping="Wrap"/>
                <DockPanel>
                  <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding WeatherRefreshMinutes, StringFormat={}{0} min}" TextWrapping="Wrap" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                  <Slider Minimum="5" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WeatherRefreshMinutes}" VerticalAlignment="Center" AutomationProperties.Name="WeatherRefreshMinutes"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="PluginsTab" Header="Pluginy">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Panele z pluginów" Style="{StaticResource SettingsSectionTitle}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
            <TextBlock Text="Wybierz paczkę .udplugin lub upuść ją na okno. Instaluj wyłącznie pluginy z zaufanego źródła: ich kod działa z uprawnieniami aplikacji." TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Zainstaluj z pliku…" Command="{Binding InstallCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Sprawdza paczkę i udostępnia jej panele w menu Dodaj panel bez restartu."/>
              <Button Content="Anuluj operację" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Przerywa operację przed zatwierdzeniem instalacji lub usunięcia."/>
            </WrapPanel>
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Installed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10" BorderThickness="0">
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right" Content="Usuń" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" ToolTip="Usuwa kod pluginu. Dane i miejsca paneli pozostają zachowane do ponownej instalacji." AutomationProperties.Name="{Binding Name, StringFormat=Usuń plugin {0}}"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Version, StringFormat=Wersja {0}}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="158"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Token.CornerRadius.M}">
              <ContentPresenter x:Name="PART_SelectedContentHost" Margin="4" ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
    </TabControl>
    <WrapPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock MaxWidth="260" TextWrapping="Wrap" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding SaveStatus}" Margin="0,0,10,6"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="Ponów zapis" Command="{Binding RetrySaveCommand}" Style="{StaticResource ToolbarButton}"/>
        <Button Command="{Binding ResetDefaultsCommand}" Content="Domyślne" Style="{StaticResource ToolbarButton}" ToolTip="Przywraca domyślne kolory, fonty i uruchamianie w trybie paska. Usuwa własną personalizację."/>
        <Button Command="{Binding CloseCommand}" Content="Zamknij" Style="{StaticResource ToolbarButton}" ToolTip="Zamyka okno ustawień. Ostatnio zapisane ustawienia pozostają aktywne."/>
      </StackPanel>
    </WrapPanel>
  </Grid>
</Window>
