<Window xmlns:loc="clr-namespace:UberDashboard.App.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:platform="clr-namespace:UberDashboard.Application.Platform;assembly=UberDashboard.Application" xmlns:controls="clr-namespace:UberDashboard.App.Controls" xmlns:theming="clr-namespace:UberDashboard.App.Theming" x:Class="UberDashboard.App.Settings.SettingsWindow" mc:Ignorable="d" Title="{loc:Text Settings}" Style="{DynamicResource ThemedWindow}" Width="900" Height="680" MinWidth="760" MinHeight="540" Background="{DynamicResource Brush.Window.Background}" Foreground="{DynamicResource Brush.Text}" WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource Token.FontFamily}" FontSize="{DynamicResource Token.FontSize.Body}">
  <Window.Resources>
    <!-- Sidebar navigation item -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource Token.CornerRadius.S}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="Normal"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Surface.Alt}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Surface.Alt}"/>
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Group of settings: transparent card with a hairline border, spaced by the page StackPanel -->
    <Style x:Key="SettingsGroup" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="SettingLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,4,16,4"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
      <Setter Property="DockPanel.Dock" Value="Right"/>
      <Setter Property="Width" Value="64"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
      <Setter Property="FontSize" Value="{DynamicResource Token.FontSize.Caption}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style x:Key="SettingSlider" TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsSnapToTickEnabled" Value="False"/>
    </Style>
    <Style x:Key="SettingCheck" TargetType="CheckBox" BasedOn="{StaticResource ThemedCheckBox}">
      <Setter Property="Margin" Value="0,5"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Margin="0,0,0,14" Foreground="{DynamicResource Brush.Text}" FontSize="22" FontWeight="SemiBold" Text="{loc:Text Settings}" TextWrapping="Wrap"/>
    <TabControl Grid.Row="1" Background="Transparent" TabStripPlacement="Left" BorderThickness="0">
      <!-- Appearance -->
      <TabItem Header="{loc:Text Appearance}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text Appearance}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="0" Text="{loc:Text ColorThemePresets}"/>
                  <ComboBox Style="{StaticResource SettingCombo}" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ColorThemePresets}" SelectedItem="{Binding SelectedColorThemePreset}" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Text ColorThemePresets}" ToolTip="{loc:Text ColorThemePresetsHelp}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="1" Text="{loc:Text Theme}"/>
                  <ComboBox Style="{StaticResource SettingCombo}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="{loc:Text Theme}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="2" Text="{loc:Text AccentColor}"/>
                  <controls:CompactColorPicker Grid.Row="2" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" SelectedColor="{Binding AccentColor}" AutomationProperties.Name="{loc:Text AccentColor2}" DefaultBrushKey="Brush.Accent"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="3" Text="{loc:Text WindowBackground}"/>
                  <controls:CompactColorPicker Grid.Row="3" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" SelectedColor="{Binding WindowBackgroundColor}" AutomationProperties.Name="{loc:Text WindowBackgroundColor}" DefaultBrushKey="Brush.Window.Background"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="4" Text="{loc:Text PanelSurface}"/>
                  <controls:CompactColorPicker Grid.Row="4" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" SelectedColor="{Binding SurfaceColor}" AutomationProperties.Name="{loc:Text PanelSurfaceColor}" DefaultBrushKey="Brush.Surface"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="5" Text="{loc:Text AlternateSurface}"/>
                  <controls:CompactColorPicker Grid.Row="5" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" SelectedColor="{Binding SurfaceAltColor}" AutomationProperties.Name="{loc:Text AlternateSurfaceColor}" DefaultBrushKey="Brush.Surface.Alt"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="6" Text="{loc:Text CornerRadius}"/>
                  <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding CornerRadius, StringFormat={}{0:0} px}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="4" Maximum="28" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}" AutomationProperties.Name="{loc:Text CornerRadius2}"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Text and spacing -->
      <TabItem Header="{loc:Text TextAndSpacing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text Text}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="0" Text="{loc:Text Font}"/>
                  <ComboBox Style="{StaticResource SettingCombo}" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedFontFamily}" AutomationProperties.Name="{loc:Text Font}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="1" Text="{loc:Text FontSize}"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding FontSize, StringFormat={}{0:0} px}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="11" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" AutomationProperties.Name="{loc:Text FontSize2}"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text Spacing}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="0" Text="{loc:Text InterfaceDensity}"/>
                  <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding DensityScale, StringFormat={}{0:0.00}x}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="0.85" Maximum="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding DensityScale}" AutomationProperties.Name="{loc:Text InterfaceDensity2}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="1" Text="{loc:Text PanelSpacing}"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding PanelSpacing, StringFormat={}{0:0} px}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="6" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PanelSpacing}" AutomationProperties.Name="{loc:Text PanelSpacing}" ToolTip="{loc:Text ChangesTheAppearanceWithoutReducingTheDivider}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="2" Text="{loc:Text DividerLine}"/>
                  <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding DividerThickness, StringFormat={}{0:0} px}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DividerThickness}" AutomationProperties.Name="{loc:Text DividerLine}" ToolTip="{loc:Text ChangesTheAppearanceWithoutReducingTheDivider}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="3" Text="{loc:Text GridColumns}"/>
                  <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding GridColumns}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="4" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GridColumns}" AutomationProperties.Name="{loc:Text GridColumns}" ToolTip="{loc:Text GridDensityHelp}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="4" Text="{loc:Text GridRows}"/>
                  <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding GridRows}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="4" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GridRows}" AutomationProperties.Name="{loc:Text GridRows}" ToolTip="{loc:Text GridDensityHelp}"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Background and transparency -->
      <TabItem Header="{loc:Text BackgroundAndTransparency}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text WallpaperAndWindowTransparency}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Text BuiltInWallpapers}"/>
                <ListBox ItemsSource="{Binding BuiltInWallpapers}" SelectedValuePath="Id" SelectedValue="{Binding SelectedBuiltInWallpaper, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Text BuiltInWallpapers}">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
                      <Setter Property="Padding" Value="4"/>
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Width="128" ToolTip="{Binding Name}">
                        <Border Width="128" Height="72" CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                          <Border.Background><ImageBrush ImageSource="{Binding ThumbnailPath}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="{loc:Text ChooseWallpaper}" Command="{Binding ChooseWallpaperCommand}" ToolTip="{loc:Text ChoosesTheImageShownBehindPanelsAnd}"/>
                  <Button Content="{loc:Text RemoveWallpaper}" Command="{Binding RemoveWallpaperCommand}" ToolTip="{loc:Text RemovesTheWallpaperFromTheAppAnd}"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,12" Text="{Binding WallpaperDisplayName, TargetNullValue={loc:Text NoWallpaperSelected}}" TextTrimming="CharacterEllipsis"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="0" Text="{loc:Text WallpaperBlur}"/>
                  <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding WallpaperBlur, StringFormat={}{0:0} px}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="0" Maximum="30" Value="{Binding WallpaperBlur}" AutomationProperties.Name="{loc:Text WallpaperBlur}" ToolTip="{loc:Text BlursTheAppWallpaper}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="1" Text="{loc:Text PanelAndBarSurfaceOpacity}"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding BackgroundSurfaceOpacity, StringFormat={}{0:P0}}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="0" Maximum="1" Value="{Binding BackgroundSurfaceOpacity}" AutomationProperties.Name="{loc:Text PanelAndBarSurfaceOpacity}" ToolTip="{loc:Text ChangesPanelBackgroundOpacityOverTheWallpaper}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="2" Text="{loc:Text AppContentOpacity}"/>
                  <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding WindowOpacity, StringFormat={}{0:P0}}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="0.2" Maximum="1" Value="{Binding WindowOpacity}" AutomationProperties.Name="{loc:Text AppContentOpacity}" ToolTip="{loc:Text ChangesTheOpacityOfTextIconsImages}"/>
                  </DockPanel>
                </Grid>
                <CheckBox Style="{StaticResource SettingCheck}" Margin="0,10,0,5" Content="{loc:Text ShowTheDesktopThroughTheAppBackground}" IsChecked="{Binding TransparentDesktopBackground}" ToolTip="{loc:Text RevealsWindowsAndTheDesktopBehindThe}"/>
                <CheckBox Style="{StaticResource SettingCheck}" Content="{loc:Text BlurBehindTheWindowWindows11}" IsChecked="{Binding DesktopBlur}" ToolTip="{loc:Text EnablesWindowsAcrylicTheEffectDependsOn}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Dock and display -->
      <TabItem Header="{loc:Text DockAndDisplay}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text WindowBehavior}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="0" Text="{loc:Text StartupMode}"/>
                  <ComboBox Style="{StaticResource SettingCombo}" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding WindowModes}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedLaunchMode}" AutomationProperties.Name="{loc:Text StartupMode}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="1" Text="{loc:Text DockDisplay}"/>
                  <ComboBox Style="{StaticResource SettingCombo}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Id" AutomationProperties.Name="{loc:Text DockDisplay}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="2" Text="{loc:Text DockEdge}"/>
                  <ComboBox Style="{StaticResource SettingCombo}" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DockEdges}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedDockEdge}" AutomationProperties.Name="{loc:Text DockEdge}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="3" Text="{loc:Text DockThickness}"/>
                  <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding DockThickness, StringFormat={}{0} px}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="200" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding DockThickness}" AutomationProperties.Name="{loc:Text DockThickness2}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="4" Text="{loc:Text WidgetOpacity}"/>
                  <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding WidgetOpacity, StringFormat={}{0:0.00}}"/>
                    <Slider Style="{StaticResource SettingSlider}" IsEnabled="False" ToolTip="{loc:Text OpacityAdjustmentWillBeAvailableOnceDesktop}" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding WidgetOpacity}" AutomationProperties.Name="{loc:Text WidgetOpacity2}"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="5" Text="{loc:Text WidgetStatus}"/>
                  <TextBlock Style="{StaticResource SettingHint}" Grid.Row="5" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" Text="{loc:Text ExperimentalTheAppCanSafelyReturnTo}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Application -->
      <TabItem Header="{loc:Text Application}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text AppLanguage}"/>
                <ComboBox Style="{StaticResource SettingCombo}" ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Code" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Text AppLanguage}" HorizontalAlignment="Left" MinWidth="220"/>
                <TextBlock Style="{StaticResource SettingHint}" Text="{loc:Text LanguageRestart}"/>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text SystemIntegration}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="0" Text="{loc:Text Startup}"/>
                  <CheckBox Style="{StaticResource SettingCheck}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Content="{loc:Text StartUberdashboardWithWindows}" IsChecked="{Binding StartWithWindows}" ToolTip="{loc:Text AddsOrRemovesTheStartupEntryFor}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="1" Text="{loc:Text TrayIcon}"/>
                  <CheckBox Style="{StaticResource SettingCheck}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Content="{loc:Text ShowTheSystemTrayIcon}" IsChecked="{Binding EnableTrayIcon}" ToolTip="{loc:Text AddsANotificationAreaIconWithShortcuts}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="2" Text="{loc:Text WhenClosingTheWindow}"/>
                  <ComboBox Style="{StaticResource SettingCombo}" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CloseBehaviorOptions}" ItemTemplate="{StaticResource SettingsEnumTemplate}" SelectedItem="{Binding SelectedCloseBehavior}" ToolTip="{loc:Text ChoosesWhetherTheCloseButtonQuitsThe}" AutomationProperties.Name="{loc:Text WhenClosingTheWindow}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text WeatherData}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Text WeatherRefreshInterval}"/>
                  <DockPanel Grid.Column="1" Margin="0,4">
                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding WeatherRefreshMinutes, StringFormat={}{0} min}"/>
                    <Slider Style="{StaticResource SettingSlider}" Minimum="5" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WeatherRefreshMinutes}" AutomationProperties.Name="{loc:Text WeatherRefreshInterval2}"/>
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Integrations -->
      <TabItem Header="{loc:Text Integrations}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Microsoft To Do"/>
                <Button HorizontalAlignment="Left" Content="{loc:Text OpenMicrosoftToDoSetup}" Click="OpenMicrosoftTodo_Click" ToolTip="{loc:Text OpensAccountConfigurationAndMicrosoftToDo}"/>
                <TextBlock Style="{StaticResource SettingHint}" Margin="0,12,0,10" Text="{loc:Text PrivacyConnectionsNotice}"/>
                <Button HorizontalAlignment="Left" Content="{loc:Text SyncCenterTitle}" AutomationProperties.Name="{loc:Text SyncCenterTitle}" Click="OpenSyncCenter_Click" ToolTip="{loc:Text SyncResourcesHelp}"/>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text IntegrationLogTitle}"/>
                <CheckBox x:Name="IntegrationLogEnabled" Style="{StaticResource SettingCheck}" Margin="0" Content="{loc:Text IntegrationLogEnabled}" ToolTip="{loc:Text IntegrationLogHelp}" Click="IntegrationLogEnabled_Click"/>
                <TextBlock x:Name="IntegrationLogStatus" Style="{StaticResource SettingHint}"/>
                <TextBox x:Name="IntegrationLogText" Margin="0,10,0,10" Height="180" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="{loc:Text IntegrationLogTitle}"/>
                <WrapPanel>
                  <Button Content="{loc:Text IntegrationLogRefresh}" Click="IntegrationLogRefresh_Click" ToolTip="{loc:Text IntegrationLogRefreshHelp}"/>
                  <Button Content="{loc:Text IntegrationLogClear}" Click="IntegrationLogClear_Click" ToolTip="{loc:Text IntegrationLogClearHelp}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroup}">
              <WrapPanel>
                <Button Content="{loc:Text ProjectWebsite}" AutomationProperties.Name="{loc:Text ProjectWebsite}" Click="OpenProjectWebsite_Click" ToolTip="{loc:Text OpenProjectWebsiteHelp}"/>
                <Button Content="{loc:Text PrivacyPolicy}" AutomationProperties.Name="{loc:Text PrivacyPolicy}" Click="OpenPrivacyPolicy_Click" ToolTip="{loc:Text OpenPrivacyPolicyHelp}"/>
              </WrapPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Plugins -->
      <TabItem x:Name="PluginsTab" Header="{loc:Text Plugins}">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource SettingsGroup}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text PluginPanels}"/>
              <WrapPanel>
                <Button Content="{loc:Text InstallFromFile}" Command="{Binding InstallCommand}" ToolTip="{loc:Text ChecksThePackageAndMakesItsPanels}"/>
                <Button Content="{loc:Text CancelOperation}" Command="{Binding CancelCommand}" ToolTip="{loc:Text CancelsBeforeInstallationOrRemovalIsCommitted}"/>
              </WrapPanel>
              <ProgressBar Height="4" Margin="0,10,0,0" IsIndeterminate="{Binding IsBusy}">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar" BasedOn="{StaticResource ThemedProgressBar}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
              <TextBlock Style="{StaticResource SettingHint}" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Installed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsGroup}" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Content="{loc:Text Remove}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{loc:Text RemovesThePluginCodePanelDataAnd}" AutomationProperties.Name="{Binding Name, StringFormat={loc:Text RemovePlugin}}"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0" Text="{Binding Version, StringFormat={loc:Text Version}}"/>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0" Text="{Binding Id}"/>
                        <TextBlock Margin="0,6,0,0" Text="{Binding Status}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- About -->
      <TabItem x:Name="AboutTab" Header="{loc:Text AboutApp}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <Border Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text AboutApp}"/>
                <TextBlock Text="UberDashboard" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource SettingLabel}" Foreground="{DynamicResource Brush.Text.Muted}" Grid.Row="0" Text="{loc:Text AboutVersion}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="{Binding AboutVersion}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Foreground="{DynamicResource Brush.Text.Muted}" Grid.Row="1" Text="{loc:Text AboutBuildTime}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="1" Grid.Column="1" Text="{Binding AboutBuildTime}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Foreground="{DynamicResource Brush.Text.Muted}" Grid.Row="2" Text="{loc:Text AboutAuthor}"/>
                  <TextBlock Style="{StaticResource SettingLabel}" Grid.Row="2" Grid.Column="1" Text="Tomasz Szabłowski"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroup}">
              <StackPanel>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Text AboutChangelog}"/>
                <TextBox Text="{Binding AboutChangelog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="350" AutomationProperties.Name="{loc:Text AboutChangelog}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Margin="0,0,14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Token.CornerRadius.M}">
              <ContentPresenter x:Name="PART_SelectedContentHost" Margin="2" ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{loc:Text RetrySave}" Command="{Binding RetrySaveCommand}"/>
        <Button Command="{Binding ResetDefaultsCommand}" Content="{loc:Text RestoreDefaults}" ToolTip="{loc:Text RestoresTheDefaultColorsFontsAndStartup}"/>
        <Button Margin="0" Command="{Binding CloseCommand}" Content="{loc:Text Close}" ToolTip="{loc:Text ClosesSettingsAndKeepsTheLastSaved}"/>
      </StackPanel>
      <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Text.Muted}" Text="{Binding SaveStatus}" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
  </Grid>
</Window>
