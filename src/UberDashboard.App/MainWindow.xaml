<Window x:Class="UberDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:UberDashboard.App.Controls"
        xmlns:platform="clr-namespace:UberDashboard.Application.Platform;assembly=UberDashboard.Application"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="UberDashboard"
        Width="1280"
        Height="820"
        MinWidth="860"
        MinHeight="560"
        FontFamily="{DynamicResource Token.FontFamily}"
        FontSize="{DynamicResource Token.FontSize.Body}"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text}">
  <Grid>
  <Image x:Name="ApplicationWallpaper" Stretch="UniformToFill" IsHitTestVisible="False">
    <Image.Effect><BlurEffect x:Name="WallpaperBlurEffect" Radius="0" /></Image.Effect>
  </Image>
  <Grid x:Name="ApplicationContent" Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Wspólne, zwarte sterowanie; rzadkie działania są w menu. -->
    <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}" Padding="{DynamicResource Token.Padding.ControlSmall}">
      <DockPanel LastChildFill="True">
        <controls:PanelLayoutMenuButton DockPanel.Dock="Right" Content="Menu" Margin="6,0,0,0"
            Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Menu pulpitu"
            ToolTip="Otwiera dodawanie paneli, edycję układu, ustawienia, motyw i tryb pracy.">
          <controls:PanelLayoutMenuButton.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Tryb okna">
              <MenuItem Header="Pasek" Command="{Binding SwitchWindowModeCommand}" CommandParameter="{x:Static platform:WindowMode.DockedBar}" />
              <MenuItem Header="Zwykłe okno" Command="{Binding SwitchWindowModeCommand}" CommandParameter="{x:Static platform:WindowMode.Normal}" />
              <MenuItem Header="Widget (eksperymentalny)" Command="{Binding SwitchWindowModeCommand}" CommandParameter="{x:Static platform:WindowMode.DesktopWidget}" ToolTip="Próbuje osadzić aplikację na pulpicie; przy błędzie wraca do okna." />
            </MenuItem>
            <MenuItem Header="Edytuj układ" IsCheckable="True" IsChecked="{Binding IsEditMode}" />
            <MenuItem Header="Dodaj panel" ItemsSource="{Binding PanelTypes}">
              <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource ToolbarMenuItem}">
                  <Setter Property="Header" Value="{Binding DisplayName}" />
                  <Setter Property="Command" Value="{Binding DataContext.AddPanelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  <Setter Property="CommandParameter" Value="{Binding TypeId}" />
                </Style>
              </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Przywróć ukryty panel" ItemsSource="{Binding HiddenPanels}">
              <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource ToolbarMenuItem}">
                  <Setter Property="Header" Value="{Binding DisplayName}" />
                  <Setter Property="Command" Value="{Binding DataContext.RestorePanelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </Style>
              </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Header="Ustawienia" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="Zmień motyw" Command="{Binding ToggleThemeCommand}" />
            <MenuItem Header="Nowy pulpit" Command="{Binding NewDashboardCommand}" />
            <MenuItem Header="Zapisz układ" Command="{Binding RetrySaveLayoutCommand}" />
            <MenuItem Header="Wczytaj ponownie" Command="{Binding ReloadCommand}" />
          </ContextMenu>
          </controls:PanelLayoutMenuButton.ContextMenu>
        </controls:PanelLayoutMenuButton>
        <TextBlock DockPanel.Dock="Left" Text="UberDashboard" VerticalAlignment="Center" Margin="6,0,16,0" FontWeight="SemiBold">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsDockedBar}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ComboBox MaxWidth="240" HorizontalAlignment="Left" MinWidth="90"
                  ItemsSource="{Binding Dashboards}" SelectedItem="{Binding SelectedDashboard}"
                  Style="{StaticResource ThemedComboBox}" AutomationProperties.Name="Aktywny pulpit"
                  ToolTip="Przełącza pulpit i wczytuje jego zapisany układ oraz panele.">
          <ComboBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="5,2" Tag="{Binding}" Click="DeleteDashboard_Click" AutomationProperties.Name="Usuń pulpit" ToolTip="Usuwa ten pulpit wraz z jego panelami i układem."><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PanelActionGlyphButton}"><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.Dashboards.Count, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="1"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>
    </Border>

    <!-- Obszar roboczy: rekursywnie renderowane drzewo paneli bieżącego pulpitu. -->
    <Grid Grid.Row="1" Margin="0,4,0,4">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
      <ContentControl Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="{Binding Root.Minimum.Width}" MinHeight="{Binding Root.Minimum.Height}" Content="{Binding Root}"
                      ContentTemplateSelector="{DynamicResource LayoutNodeTemplateSelector}"
                      ToolTip="Obszar roboczy pulpitu. Przy braku miejsca przewiń obszar; dzielniki obsługują mysz i strzałki klawiatury." />
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.Text.Muted}"
                 Text="Ten pulpit nie ma jeszcze paneli. Użyj „Dodaj panel”, aby rozpocząć."
                 TextWrapping="Wrap"
                 Visibility="{Binding IsLayoutEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- Pasek stanu: opis bieżącej operacji i wskaźnik pracy w tle. -->
    <Border Grid.Row="2">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource ToolbarBorder}">
          <Style.Triggers><DataTrigger Binding="{Binding IsDockedBar}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right"
                     Width="120"
                     Height="12"
                     VerticalAlignment="Center"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                     ToolTip="Wskaźnik operacji wykonywanej w tle (wczytywanie, zapis). Interfejs pozostaje w tym czasie aktywny." />
        <TextBlock VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text.Muted}"
                   Text="{Binding WindowModeLabel, StringFormat=Aktywny tryb: {0}}"
                   TextWrapping="Wrap"
                   ToolTip="Opis aktywnego trybu pracy głównego okna aplikacji." />
      </DockPanel>
    </Border>

    <!-- Nakładka komunikatów globalnych; nie przechwytuje kliknięć poza kartami. -->
    <ItemsControl Grid.RowSpan="3"
                  Margin="16"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  ItemsSource="{Binding Toasts}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource ToastCard}">
            <TextBlock Style="{StaticResource ToastText}" Text="{Binding Text}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
  </Grid>
</Window>
