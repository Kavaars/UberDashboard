<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tokeny motywu ciemnego. Kontrast tekstu i tekstu pomocniczego >= 4.5:1. -->
  <SolidColorBrush x:Key="Brush.Window.Background" Color="#FF242825" />
  <SolidColorBrush x:Key="Brush.Panel.DefaultText" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Popup" Color="#FF2D322E" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FF2D322E" />
  <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#FF373E38" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FFECEEE7" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#FFB5BFB5" />
