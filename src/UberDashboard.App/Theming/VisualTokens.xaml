<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Bazowe tokeny wizualne. ThemeService może je nadpisać dynamicznie bez restartu. -->
  <FontFamily x:Key="Token.FontFamily">Segoe UI</FontFamily>
  <sys:Double x:Key="Token.FontSize.Body">13</sys:Double>
  <sys:Double x:Key="Token.FontSize.Caption">12</sys:Double>

  <CornerRadius x:Key="Token.CornerRadius.S">8</CornerRadius>
  <CornerRadius x:Key="Token.CornerRadius.M">12</CornerRadius>
  <CornerRadius x:Key="Token.CornerRadius.L">18</CornerRadius>

  <Thickness x:Key="Token.Padding.Control">12,7,12,7</Thickness>
  <Thickness x:Key="Token.Padding.ControlSmall">8,4,8,4</Thickness>
  <Thickness x:Key="Token.Padding.Toolbar">18,14,18,14</Thickness>
  <Thickness x:Key="Token.Padding.Panel">14</Thickness>

</ResourceDictionary>
