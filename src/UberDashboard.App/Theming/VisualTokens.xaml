<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <SolidColorBrush x:Key="Brush.MicrosoftTodo.TabBorder" Color="#468FD6" />

  <!-- Bazowe tokeny wizualne. ThemeService może je nadpisać dynamicznie bez restartu. -->
  <FontFamily x:Key="Token.FontFamily">Segoe UI</FontFamily>
  <sys:Double x:Key="Token.FontSize.Body">13</sys:Double>
  <sys:Double x:Key="Token.FontSize.Caption">12</sys:Double>

  <CornerRadius x:Key="Token.CornerRadius.S">8</CornerRadius>
  <CornerRadius x:Key="Token.CornerRadius.M">18</CornerRadius>
  <CornerRadius x:Key="Token.CornerRadius.L">18</CornerRadius>

  <Thickness x:Key="Token.Padding.Control">10,5,10,5</Thickness>
  <Thickness x:Key="Token.Padding.ControlSmall">7,3,7,3</Thickness>
  <Thickness x:Key="Token.Padding.Toolbar">12,8,12,8</Thickness>
  <Thickness x:Key="Token.Padding.Panel">12</Thickness>

  <Thickness x:Key="Token.Margin.Panel">2</Thickness>
  <sys:Double x:Key="Token.Splitter.Line">1</sys:Double>
</ResourceDictionary>
