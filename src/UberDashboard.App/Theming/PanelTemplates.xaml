<ResourceDictionary xmlns:loc="clr-namespace:UberDashboard.App.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

                    xmlns:controls="clr-namespace:UberDashboard.App.Controls"

                    xmlns:documents="clr-namespace:System.Windows.Documents;assembly=PresentationFramework"

                    xmlns:affirmations="clr-namespace:UberDashboard.App.Features.Affirmations"

                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"

                    xmlns:notes="clr-namespace:UberDashboard.App.Features.Notes"

                    xmlns:shell="clr-namespace:UberDashboard.App.Shell"

                    xmlns:todo="clr-namespace:UberDashboard.App.Features.Todo"

                    xmlns:weather="clr-namespace:UberDashboard.App.Features.Weather"
                    xmlns:calendar="clr-namespace:UberDashboard.App.Features.Calendar"
                    xmlns:resources="clr-namespace:UberDashboard.App.Features.Resources" xmlns:shortcuts="clr-namespace:UberDashboard.App.Features.Shortcuts">
  <DataTemplate DataType="{x:Type shortcuts:ShortcutsPanel}"><shortcuts:ShortcutsView/></DataTemplate>




  <BooleanToVisibilityConverter x:Key="CalendarVisibility"/>

  <DataTemplate x:Key="CalendarOptionsTemplate">
    <StackPanel>
      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="IsEnabled" Value="False"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <StackPanel Visibility="{Binding UsesDayCount, Converter={StaticResource CalendarVisibility}}">
          <TextBlock Text="{Binding Days, StringFormat={loc:Text NumberOfDays}}"/>
          <Slider Minimum="1" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Days}" AutomationProperties.Name="{loc:Text NumberOfDaysToDisplay}"/>
        </StackPanel>
        <CheckBox Content="{loc:Text ShowEventTimes}" IsChecked="{Binding ShowTimes}"/>
        <CheckBox Content="{loc:Text ShowEmptyDaysInTheSingleColumn}" IsChecked="{Binding ShowEmptyDays}"/>
        <TextBlock Text="{loc:Text GoogleCalendarId}"/>
        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding CalendarId}"
                 AutomationProperties.Name="{loc:Text GoogleCalendarId}"
                 ToolTip="{loc:Text EnterPrimaryForYourMainCalendarOr}"/>
        <WrapPanel Margin="0,4,0,0">
          <Button Command="{Binding ConnectCommand}" Content="{loc:Text ConnectGoogle}"
                  ToolTip="{loc:Text SelectTheOauthDesktopClientJsonFile}"/>
          <Button Command="{Binding DisconnectCommand}" Content="{loc:Text Disconnect}"
                  ToolTip="{loc:Text RemovesThisPanelSSavedGoogleCredentials}"/>
          <Button Command="{Binding RefreshCommand}" Content="{loc:Text Refresh}"
                  ToolTip="{loc:Text FetchesEventsForTheCurrentDateRange}"/>
        </WrapPanel>
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"
                 AutomationProperties.LiveSetting="Polite"/>
      <Button Command="{Binding CancelCommand}" Content="{loc:Text Cancel}" HorizontalAlignment="Left"
              Visibility="{Binding IsBusy, Converter={StaticResource CalendarVisibility}}"/>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type calendar:CalendarPanel}">
    <DockPanel Margin="{DynamicResource Token.Padding.Panel}">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="IsEnabled" Value="False"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <WrapPanel>
          <Button Command="{Binding PreviousCommand}" Content="‹" AutomationProperties.Name="{loc:Text PreviousPeriod}" ToolTip="{loc:Text MovesToThePreviousDateRange}"/>
          <Button Command="{Binding GoToTodayCommand}" Content="{loc:Text Today}" AutomationProperties.Name="{loc:Text CurrentPeriod}" ToolTip="{loc:Text ReturnsToTheRangeContainingTodayS}"/>
          <Button Command="{Binding NextCommand}" Content="›" AutomationProperties.Name="{loc:Text NextPeriod}" ToolTip="{loc:Text MovesToTheNextDateRange}"/>
          <Button Command="{Binding OpenSyncEditorCommand}" Content="{loc:Text SyncEditorTitle}" AutomationProperties.Name="{loc:Text SyncEditorTitle}" ToolTip="{loc:Text SyncEnableHelp}" Style="{StaticResource ToolbarButton}"/>
          <ComboBox Style="{StaticResource ThemedComboBox}" Margin="6,0,0,0" MinWidth="122"
                    ItemsSource="{Binding Modes}" SelectedValue="{Binding Mode}" SelectedValuePath="Mode"
                    DisplayMemberPath="Label" AutomationProperties.Name="{loc:Text CalendarView}"/>
        </WrapPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <TextBlock Text="{Binding PeriodLabel}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button Command="{Binding CancelCommand}" Content="{loc:Text Cancel}" HorizontalAlignment="Left"
                Visibility="{Binding IsBusy, Converter={StaticResource CalendarVisibility}}"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding VisibleDays}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Columns}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,2,2" Padding="3" MinHeight="36" ToolTip="{Binding FullDate}">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding FullDate}"/>
                    <ItemsControl ItemsSource="{Binding Events}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="0,2,0,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="1">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Agenda}" Visibility="{Binding IsAgenda, Converter={StaticResource CalendarVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,3"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type resources:ResourcePanel}">
    <DockPanel Margin="{DynamicResource Token.Padding.Panel}">
      <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Readings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Device}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>
  <controls:RemainingTextBrushConverter x:Key="RemainingTextBrushConverter"/>
  <DataTemplate DataType="{x:Type space:SpacePanelViewModel}" xmlns:space="clr-namespace:UberDashboard.App.Features.Space"><Grid /></DataTemplate>





  <DataTemplate x:Key="AffirmationOptionsTemplate">

    <StackPanel>

      <TextBlock Text="{loc:Text AffirmationsOnePerLine}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />

      <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Texts, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Text AffirmationList}" ToolTip="{loc:Text EachNonemptyLineIsAnAffirmationEditing}" />

      <CheckBox Margin="0,10,0,4" Style="{StaticResource ThemedCheckBox}" Content="{loc:Text AffirmationDailyReset}" IsChecked="{Binding DailyResetEnabled}" ToolTip="{loc:Text AffirmationDailyResetHelp}"/>
      <WrapPanel IsEnabled="{Binding DailyResetEnabled}">
        <TextBlock Text="{loc:Text AffirmationResetHour}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Style="{StaticResource ThemedComboBox}" Width="68" ItemsSource="{Binding ResetHourOptions}" SelectedItem="{Binding ResetHour}" AutomationProperties.Name="{loc:Text AffirmationResetHour}" ToolTip="{loc:Text AffirmationDailyResetHelp}"/>
        <TextBlock Text="{loc:Text AffirmationResetMinute}" VerticalAlignment="Center" Margin="10,0,6,0"/>
        <ComboBox Style="{StaticResource ThemedComboBox}" Width="68" ItemsSource="{Binding ResetMinuteOptions}" SelectedItem="{Binding ResetMinute}" AutomationProperties.Name="{loc:Text AffirmationResetMinute}" ToolTip="{loc:Text AffirmationDailyResetHelp}"/>
      </WrapPanel>

      <Expander Header="{loc:Text AffirmationAppearance}" Margin="0,10,0,0"><StackPanel>

        <TextBlock Text="{loc:Text FontName}" Foreground="{DynamicResource Brush.Text}"/><TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{loc:Text AffirmationFont}"/>

        <TextBlock Text="{loc:Text TextSize}" Foreground="{DynamicResource Brush.Text}"/><Slider Minimum="10" Maximum="72" Value="{Binding FontSize}" AutomationProperties.Name="{loc:Text AffirmationTextSize}"/>

        <TextBlock Text="{loc:Text LineSpacing}" Foreground="{DynamicResource Brush.Text}"/><Slider Minimum="12" Maximum="100" Value="{Binding LineHeight}" AutomationProperties.Name="{loc:Text AffirmationLineSpacing}"/>
        <TextBlock Text="{loc:Text UntypedTextColor}" Foreground="{DynamicResource Brush.Text}" Margin="0,8,0,2"/><controls:CompactColorPicker SelectedColor="{Binding RemainingColor}" DefaultBrushKey="Brush.Text" AutomationProperties.Name="{loc:Text UntypedAffirmationTextColor}"/>
        <TextBlock Text="{loc:Text UntypedTextOpacity}" Foreground="{DynamicResource Brush.Text}"/><Slider Minimum="0" Maximum="1" Value="{Binding RemainingOpacity}" AutomationProperties.Name="{loc:Text UntypedAffirmationTextOpacity}" ToolTip="{loc:Text ChangesOpacityForThePartOfThe}"/>





      </StackPanel></Expander>

      <Expander Header="{loc:Text StatisticsAndHistory}" Margin="0,10,0,0"><StackPanel>

        <TextBlock Text="{Binding TotalAffirmations, StringFormat={loc:Text TotalAffirmations}}" Foreground="{DynamicResource Brush.Text}"/>

        <TextBlock Text="{Binding TotalSets, StringFormat={loc:Text CompletedSets}}" Foreground="{DynamicResource Brush.Text}"/>

        <TextBlock Text="{Binding CurrentStreak, StringFormat={loc:Text CurrentStreakDays}}" Foreground="{DynamicResource Brush.Text}"/>

        <TextBlock Text="{loc:Text DailyHistoryAndStreaksCompletingASet}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>

        <TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/><TextBlock Text="{loc:Text StreakHistory}" Foreground="{DynamicResource Brush.Text}"/><TextBlock Text="{Binding StreakHistory}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>

      </StackPanel></Expander>

    </StackPanel>

  </DataTemplate>

  <DataTemplate DataType="{x:Type affirmations:AffirmationPanelViewModel}">

    <Grid Margin="{DynamicResource Token.Padding.Panel}">

      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text Reset}" Style="{StaticResource ToolbarButton}" Command="{Binding ResetCommand}" ToolTip="{loc:Text RestartsAllAffirmationsAndResetsTheAutomatic}"/><Grid DockPanel.Dock="Right" Width="120" Height="32" Margin="4,0">

          <controls:AffirmationInput x:Name="AffirmationEditor" Padding="8,2" Style="{StaticResource ThemedTextBox}" IsEnabled="{Binding HasCurrent}" AutomationProperties.Name="{loc:Text TypeTheDisplayedAffirmation}" ToolTip="{loc:Text ClickHereOrOnTheAffirmationAnd}"/>

          <TextBlock Text="{loc:Text TypeHere}" Margin="9,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" IsHitTestVisible="False">

            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AffirmationEditor}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>

          </TextBlock>

        </Grid><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/></DockPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8"><StackPanel Background="Transparent" controls:AffirmationInput.FocusTarget="{Binding ElementName=AffirmationEditor}" ToolTip="{loc:Text ClickTheTextToStartTyping}">

        <TextBlock Text="{Binding Completed}" Foreground="{DynamicResource Brush.Text}" FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}" TextWrapping="Wrap" />

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}"><Run Text="{Binding Typed, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"/><Run Text="{Binding Remaining, Mode=OneWay}"><Run.Foreground><MultiBinding Converter="{StaticResource RemainingTextBrushConverter}"><Binding Path="RemainingColor"/><Binding Path="RemainingOpacity"/><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=TextBlock}"/></MultiBinding></Run.Foreground></Run></TextBlock>

      </StackPanel></ScrollViewer>



    </Grid>

  </DataTemplate>



<DataTemplate x:Key="NotesOptionsTemplate">

        <Border>

          <StackPanel>

            <TextBlock FontWeight="SemiBold"

                       Foreground="{DynamicResource Brush.Text}"

                       Text="{loc:Text NotepadOptions}" />

            <CheckBox Margin="0,12,0,0"

                      Content="{loc:Text WrapLinesInTheEditor}"

                      IsChecked="{Binding WordWrapEnabled}"

                      Style="{StaticResource ThemedCheckBox}"

                      ToolTip="{loc:Text TogglesWrappingWithWrappingOffLongLines}" />

            <DockPanel Margin="0,12,0,0">

              <StackPanel DockPanel.Dock="Right"

                          Orientation="Horizontal">

                <Button Command="{Binding ImportCommand}"

                        Content="&#xE8B5;"

                        Style="{StaticResource PanelActionGlyphButton}"

                        ToolTip="{loc:Text LoadsANoteFromATextFile}" />

                <Button Command="{Binding ExportCommand}"

                        Content="&#xE898;"

                        Style="{StaticResource PanelActionGlyphButton}"

                        ToolTip="{loc:Text SavesTheCurrentNoteToAText}" />

              </StackPanel>

              <TextBlock VerticalAlignment="Center"

                         Foreground="{DynamicResource Brush.Text.Muted}"

                         Text="{loc:Text ImportExport}" />

            </DockPanel>

            <TextBlock Margin="0,12,0,0"

                       Foreground="{DynamicResource Brush.Text.Muted}"

                       Text="{loc:Text PasteImagesIntoTheEditorWithCtrl}"

                       TextWrapping="Wrap" />

          </StackPanel>

        </Border>



</DataTemplate>

<DataTemplate x:Key="TodoSpacingOptionsTemplate">
  <StackPanel>
    <TextBlock Margin="0,12,0,0" Text="{loc:Text TodoEdgeSpacing}" Foreground="{DynamicResource Brush.Text}" />
    <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding EdgeSpacing}" AutomationProperties.Name="{loc:Text TodoEdgeSpacing}" ToolTip="{loc:Text TodoEdgeSpacingHelp}" />
    <TextBlock Margin="0,8,0,0" Text="{loc:Text TodoEntrySpacing}" Foreground="{DynamicResource Brush.Text}" />
    <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding EntrySpacing}" AutomationProperties.Name="{loc:Text TodoEntrySpacing}" ToolTip="{loc:Text TodoEntrySpacingHelp}" />
  </StackPanel>
</DataTemplate>

<Style x:Key="TodoListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
  <Setter Property="Padding" Value="{Binding DataContext.EntryPadding, RelativeSource={RelativeSource AncestorType=ListBox}}" />
  <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource Token.CornerRadius.S}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface.Alt}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface.Alt}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Setter.Value></Setter>
</Style>

<DataTemplate x:Key="TodoOptionsTemplate">
  <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Text="{loc:Text TaskListOptions}" />
    <CheckBox Margin="0,12,0,0" Content="{loc:Text ShowCompletedTaskSummary}" IsChecked="{Binding ShowSummary}" Style="{StaticResource ThemedCheckBox}" ToolTip="{loc:Text ShowsTheNumberOfCompletedTasksAt}" />
    <CheckBox Margin="0,10,0,0" Content="{loc:Text TodoOnlyIncomplete}" IsChecked="{Binding ShowOnlyIncomplete}" Style="{StaticResource ThemedCheckBox}" />
    <TextBlock Margin="0,10,0,2" Text="{loc:Text TodoDisplayLimit}" Foreground="{DynamicResource Brush.Text}" />
    <TextBox AutomationProperties.Name="{loc:Text TodoDisplayLimit}" Style="{StaticResource ThemedTextBox}" Text="{Binding CompletedDisplayLimit, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
    <TextBlock Margin="0,10,0,2" Text="{loc:Text TodoKeepLimit}" Foreground="{DynamicResource Brush.Text}" />
    <TextBox AutomationProperties.Name="{loc:Text TodoKeepLimit}" Style="{StaticResource ThemedTextBox}" Text="{Binding CompletedKeepLimit, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
    <Button Margin="0,8,0,0" Content="{loc:Text TodoKeepAction}" Command="{Binding KeepCompletedCommand}" Style="{StaticResource ToolbarButton}" />
    <Button Margin="0,8,0,0" Content="{loc:Text TodoClearAction}" Command="{Binding ClearCompletedCommand}" Style="{StaticResource ToolbarButton}" />
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TodoSpacingOptionsTemplate}" />
  </StackPanel></ScrollViewer>
</DataTemplate>

<DataTemplate x:Key="MicrosoftTodoOptionsTemplate">
  <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Text="{loc:Text TaskListOptions}" />
    <CheckBox Margin="0,10,0,0" Content="{loc:Text TodoOnlyIncomplete}" IsChecked="{Binding ShowOnlyIncomplete}" Style="{StaticResource ThemedCheckBox}" />
    <TextBlock Margin="0,10,0,2" Text="{loc:Text TodoDisplayLimit}" Foreground="{DynamicResource Brush.Text}" />
    <TextBox AutomationProperties.Name="{loc:Text TodoDisplayLimit}" Style="{StaticResource ThemedTextBox}" Text="{Binding CompletedDisplayLimit, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
    <TextBlock Margin="0,10,0,2" Text="{loc:Text TodoKeepLimit}" Foreground="{DynamicResource Brush.Text}" />
    <TextBox AutomationProperties.Name="{loc:Text TodoKeepLimit}" Style="{StaticResource ThemedTextBox}" Text="{Binding CompletedKeepLimit, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
    <Button Margin="0,8,0,0" Content="{loc:Text TodoKeepAction}" Command="{Binding KeepCompletedCommand}" Style="{StaticResource ToolbarButton}" />
    <Button Margin="0,8,0,0" Content="{loc:Text TodoClearAction}" Command="{Binding ClearCompletedCommand}" Style="{StaticResource ToolbarButton}" />
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TodoSpacingOptionsTemplate}" />
    <TextBlock Margin="0,8,0,0" Text="{loc:Text TodoSyncEnableFirst}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" />
  </StackPanel></ScrollViewer>
</DataTemplate>

<DataTemplate x:Key="WeatherOptionsTemplate">

        <Border>

          <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto"><Grid>

            <Grid.RowDefinitions>

              <RowDefinition Height="Auto" />

              <RowDefinition Height="Auto" />

              <RowDefinition Height="Auto" />

              <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>



            <TextBlock Grid.Row="0"

                       FontWeight="SemiBold"

                       Foreground="{DynamicResource Brush.Text}"

                       Text="{loc:Text WeatherOptions}" />



            <DockPanel Grid.Row="1"

                       Margin="0,12,0,0">

              <StackPanel DockPanel.Dock="Right"

                          Orientation="Horizontal">

                <Button Command="{Binding RefreshCommand}"

                        Content="&#xE72C;"

                        Style="{StaticResource PanelActionGlyphButton}"

                        ToolTip="{loc:Text FetchesTheLatestConditionsForTheSelected}" />

                <Button Command="{Binding ClearLocationCommand}"

                        Content="&#xE711;"

                        Style="{StaticResource PanelActionGlyphButton}"

                        ToolTip="{loc:Text ClearsThisPanelSLocationAndStops}" />

              </StackPanel>

              <TextBox Style="{StaticResource ThemedTextBox}"

                       IsEnabled="{Binding IsNetworkEnabled}"

                       AutomationProperties.Name="{loc:Text SearchForALocation}"

                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"

                       ToolTip="{loc:Text EnterACityNameThePanelSearches}" />

            </DockPanel>



            <Border Grid.Row="2"

                    Margin="0,10,0,0"

                    Background="{DynamicResource Brush.Surface.Alt}"

                    BorderBrush="{DynamicResource Brush.Border}"

                    BorderThickness="1"

                    CornerRadius="{DynamicResource Token.CornerRadius.S}"

                    Padding="8">

              <ItemsControl ItemsSource="{Binding SearchResults}">

                <ItemsControl.Style>

                  <Style TargetType="ItemsControl">

                    <Setter Property="Visibility" Value="Visible" />

                    <Style.Triggers>

                      <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">

                        <Setter Property="Visibility" Value="Collapsed" />

                      </DataTrigger>

                    </Style.Triggers>

                  </Style>

                </ItemsControl.Style>

                <ItemsControl.ItemTemplate>

                  <DataTemplate>

                    <DockPanel Margin="0,0,0,4">

                      <Button DockPanel.Dock="Right"

                              Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"

                              CommandParameter="{Binding}"

                              Content="&#xE8FB;"

                              Style="{StaticResource PanelActionGlyphButton}"

                              ToolTip="{loc:Text SelectsThisLocationForTheCurrentPanel}" />

                      <TextBlock VerticalAlignment="Center"

                                 Foreground="{DynamicResource Brush.Text}"

                                 Text="{Binding DisplayName}"

                                 TextWrapping="Wrap" />

                    </DockPanel>

                  </DataTemplate>

                </ItemsControl.ItemTemplate>

              </ItemsControl>

            </Border>



            <StackPanel Grid.Row="3"

                        Margin="0,12,0,0">

              <TextBlock Foreground="{DynamicResource Brush.Text.Muted}"

                         Text="{Binding AutoRefreshMinutes, StringFormat={loc:Text AutoRefreshEveryMin}}" />

              <Slider Margin="0,4,0,0"

                      IsSnapToTickEnabled="True"

                      Maximum="180"

                      Minimum="5"

                      TickFrequency="5"

                      Value="{Binding AutoRefreshMinutes}" />

              <CheckBox Margin="0,10,0,0"

                        Content="{loc:Text ShowWindSpeed}"

                        IsChecked="{Binding ShowWind}"

                        Style="{StaticResource ThemedCheckBox}"

                        ToolTip="{loc:Text ShowsOrHidesWindSpeedOnThe}" />

              <CheckBox Margin="0,8,0,0"

                        Content="{loc:Text ShowLastUpdateTime}"

                        IsChecked="{Binding ShowUpdatedTime}"

                        Style="{StaticResource ThemedCheckBox}"

                        ToolTip="{loc:Text ShowsOrHidesTheTimeOfThe}" />

      <StackPanel Margin="0,12,0,0">

        <CheckBox Content="{loc:Text AllowConnectionsToOpenMeteo}"

                  IsChecked="{Binding IsNetworkEnabled}"

                  Style="{StaticResource ThemedCheckBox}"

                  ToolTip="{loc:Text WhenEnabledOpenMeteoReceivesTheSearch}" />

        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" Text="{loc:Text CurrentModelConditionsChooseACityIn}" />

        <TextBlock

                 Foreground="{DynamicResource Brush.Text.Muted}"

                 Text="{Binding StatusText}"

                 TextWrapping="Wrap"

                 ToolTip="{loc:Text ShowsTheWeatherPanelSCurrentState}" />

        <WrapPanel Margin="0,6,0,0">

          <Button Content="Open-Meteo" Command="{Binding OpenSourceCommand}" CommandParameter="weather" Style="{StaticResource PanelActionButton}" ToolTip="{loc:Text OpensTheForecastProviderSWebsiteIn}" />

          <Button Content="{loc:Text DataLicense}" Command="{Binding OpenSourceCommand}" CommandParameter="licence" Style="{StaticResource PanelActionButton}" ToolTip="{loc:Text OpensInformationAboutTheWeatherDataSources}" />

          <Button Content="GeoNames" Command="{Binding OpenSourceCommand}" CommandParameter="geonames" Style="{StaticResource PanelActionButton}" ToolTip="{loc:Text OpensThePlaceNameSourceUsedBy}" />

        </WrapPanel>

        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Text="{loc:Text DataOpenMeteoCcBy40}" />

      </StackPanel>

            </StackPanel>

          </Grid></ScrollViewer>

        </Border>



</DataTemplate>

<DataTemplate x:Key="ExtensionOptionsTemplate"><Button Content="{loc:Text ExtensionOptions}" Command="{Binding ToggleOptionsCommand}" Style="{StaticResource PanelActionButton}" /></DataTemplate>

<controls:PanelOptionsTemplateSelector x:Key="PanelOptionsSelector" />

  <DataTemplate DataType="{x:Type notes:NotesPanelViewModel}">

    <controls:AdaptivePanelGrid Tag="notes" Margin="{DynamicResource Token.Padding.Panel}">

      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>

      <Grid.RowDefinitions>

        <RowDefinition Height="Auto" />

        <RowDefinition Height="Auto" />

        <RowDefinition Height="*" />

      </Grid.RowDefinitions>



      <Border x:Name="NotesOptionsAnchor"

              Width="1"

              Height="1"

