          <DockPanel>

            <WrapPanel DockPanel.Dock="Right" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=controls:PanelAppearanceBorder}, Converter={StaticResource PanelHeaderWidth}}">

              <Button AutomationProperties.Name="{loc:Text TextFormatting}" Command="{Binding ToggleFormattingCommand}"

                      Content="&#xE8D2;"

                      ToolTip="{loc:Text ShowsOrHidesTheFormattingToolbarFor}"

                      Visibility="{Binding HasFormatting, Converter={StaticResource BoolToVisibility}}">

                <Button.Style>

                  <Style TargetType="Button" BasedOn="{StaticResource PanelActionGlyphButton}">

                    <Style.Triggers>

                      <DataTrigger Binding="{Binding IsFormattingVisible}" Value="True">

                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />

                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />

                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />

                      </DataTrigger>

                    </Style.Triggers>

                  </Style>

                </Button.Style>

              </Button>

              <Button AutomationProperties.Name="{loc:Text PanelOptions}" Command="{Binding ToggleOptionsCommand}"

                      Content="&#xE712;"

                      ToolTip="{loc:Text ShowsOrHidesThisPanelSFloating}"

                      Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">

                <Button.Style>

                  <Style TargetType="Button" BasedOn="{StaticResource PanelActionGlyphButton}">

                    <Style.Triggers>

                      <DataTrigger Binding="{Binding IsOptionsOpen}" Value="True">

                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />

                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />

                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />

                      </DataTrigger>

                    </Style.Triggers>

                  </Style>

                </Button.Style>

              </Button>

              <controls:PanelLayoutMenuButton Content="{loc:Text Layout}" Style="{StaticResource PanelActionButton}"

                      AutomationProperties.Name="{loc:Text PanelLayout}"

                      ToolTip="{loc:Text AddsOrMovesAPanelBesideOr}"

                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">

                <controls:PanelLayoutMenuButton.ContextMenu>

                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding LayoutActions}">

                    <ContextMenu.ItemContainerStyle>

                      <Style TargetType="MenuItem" BasedOn="{StaticResource ToolbarMenuItem}">

                        <Setter Property="Header" Value="{Binding Header}" />

                        <Setter Property="Command" Value="{Binding Command}" />

                      </Style>

                    </ContextMenu.ItemContainerStyle>

                  </ContextMenu>

                </controls:PanelLayoutMenuButton.ContextMenu>

              </controls:PanelLayoutMenuButton>

              <Button AutomationProperties.Name="{loc:Text SwapPanels}" Command="{Binding DataContext.SwapPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                      CommandParameter="{Binding}"

                      Content="&#xE8AB;"

                      Style="{StaticResource PanelActionGlyphButton}"

                      ToolTip="{loc:Text SelectsThisPanelToSwapPositionsWith}"

                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />

              <Button AutomationProperties.Name="{loc:Text HidePanel}" Command="{Binding DataContext.HidePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                      CommandParameter="{Binding}"

                      Content="&#xE8F4;"

                      Style="{StaticResource PanelActionGlyphButton}"

                      ToolTip="{loc:Text HidesThisPanelAndKeepsItsData}"

                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />

              <Button AutomationProperties.Name="{loc:Text DeletePanel}" Command="{Binding DataContext.RemovePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                      CommandParameter="{Binding}"

                      Content="&#xE74D;"

                      Style="{StaticResource PanelActionGlyphButton}"

                      ToolTip="{loc:Text PermanentlyDeletesThisPanelAndItsSaved}"

                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />

            </WrapPanel>



            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">

              <Border Width="28"

                      Height="28"

                      Margin="0,0,8,0"

                      Background="{DynamicResource Brush.Surface}"

                      BorderBrush="{DynamicResource Brush.Border}"

                      BorderThickness="1"

                      CornerRadius="{DynamicResource Token.CornerRadius.S}">

                <TextBlock HorizontalAlignment="Center"

                           VerticalAlignment="Center"

                           FontFamily="Segoe MDL2 Assets"

                           FontSize="14"

                           Foreground="{DynamicResource Brush.Accent}"

                           Text="{Binding IconGlyph}" />

              </Border>

              <TextBlock VerticalAlignment="Center"

                         FontWeight="SemiBold"

                         Foreground="{DynamicResource Brush.Text}"

                         Text="{Binding DisplayName}"

                         TextTrimming="CharacterEllipsis"

                         ToolTip="{loc:Text InEditModeDragThisTitleTo}" />

              <Ellipse Width="7"

                       Height="7"

                       Margin="6,0,0,0"

                       VerticalAlignment="Center"

                       Fill="{DynamicResource Brush.Warning}"

                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"

                       ToolTip="{loc:Text ThisPanelHasChangesWaitingToBe}" />

            </StackPanel>
            <controls:PanelGroupTabStrip Session="{Binding TabSession}" Margin="8,0,0,0" VerticalAlignment="Center" />

          </DockPanel>

        </Border>



        <controls:PanelEdgeThumb IsTop="True" Height="7" Grid.RowSpan="2" VerticalAlignment="Top" Panel.ZIndex="30" Visibility="{Binding IsEditablePanel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Text ResizeFromTheTop}" ToolTip="{loc:Text DragDownToLeaveSpaceAboveThe}" />

        <controls:PanelEdgeThumb Height="7" Grid.RowSpan="2" VerticalAlignment="Bottom" Panel.ZIndex="30" Visibility="{Binding IsEditablePanel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Text ResizeFromTheBottom}" ToolTip="{loc:Text DragUpToLeaveSpaceBelowThe}" />

        <Grid Grid.Row="1" ClipToBounds="True"><Image Source="{Binding Appearance.Wallpaper}" Opacity="{Binding Appearance.WallpaperOpacity}" Stretch="UniformToFill" IsHitTestVisible="False" /><DockPanel><controls:ResponsivePanelContent Content="{Binding PanelContent}"><controls:ResponsivePanelContent.Style><Style TargetType="controls:ResponsivePanelContent"><Style.Triggers><DataTrigger Binding="{Binding TabSession.IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></controls:ResponsivePanelContent.Style></controls:ResponsivePanelContent></DockPanel><Border VerticalAlignment="Bottom" Background="{DynamicResource Brush.Popup}" Padding="8,3" Visibility="{Binding TabSession.IsBusy, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{loc:Text SwitchingTabs}" Foreground="{DynamicResource Brush.Text}" /></Border></Grid>

        <controls:PanelLayoutMenuButton Grid.RowSpan="2" Content="{loc:Text AddAPanelHere}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PanelActionButton}" Visibility="{Binding IsEditableSpace, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Text FillEmptySpace}">

          <controls:PanelLayoutMenuButton.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding LayoutActions}"><ContextMenu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource ToolbarMenuItem}"><Setter Property="Header" Value="{Binding Header}" /><Setter Property="Command" Value="{Binding Command}" /></Style></ContextMenu.ItemContainerStyle></ContextMenu></controls:PanelLayoutMenuButton.ContextMenu>

        </controls:PanelLayoutMenuButton>

      </Grid>

    </controls:PanelAppearanceBorder>

  </DataTemplate>



  <DataTemplate x:Key="PanelSplitHorizontalTemplate">

    <Grid>

      <Grid.ColumnDefinitions>

        <ColumnDefinition Width="{Binding FirstLength}" MinWidth="{Binding First.Minimum.Width}" />

        <ColumnDefinition Width="Auto" />

        <ColumnDefinition Width="{Binding SecondLength}" MinWidth="{Binding Second.Minimum.Width}" />

      </Grid.ColumnDefinitions>



      <ContentControl Grid.Column="0"

                      Content="{Binding First}"

                      ContentTemplateSelector="{DynamicResource LayoutNodeTemplateSelector}" />



      <controls:PersistedGridSplitter Grid.Column="1"

                    Width="6"

                    HorizontalAlignment="Center"

                    VerticalAlignment="Stretch"

                    Background="{DynamicResource Brush.Splitter}"

                    ResizeBehavior="PreviousAndNext"

                    ResizeDirection="Columns"

                    ToolTip="{loc:Text DragToResizeNeighboringPanelsYouCan}" />



      <ContentControl Grid.Column="2"

                      Content="{Binding Second}"

                      ContentTemplateSelector="{DynamicResource LayoutNodeTemplateSelector}" />

    </Grid>

  </DataTemplate>



  <DataTemplate x:Key="PanelSplitVerticalTemplate">

    <Grid>

      <Grid.RowDefinitions>

        <RowDefinition Height="{Binding FirstLength}" MinHeight="{Binding First.Minimum.Height}" />

        <RowDefinition Height="Auto" />

        <RowDefinition Height="{Binding SecondLength}" MinHeight="{Binding Second.Minimum.Height}" />

      </Grid.RowDefinitions>



      <ContentControl Grid.Row="0"

                      Content="{Binding First}"

                      ContentTemplateSelector="{DynamicResource LayoutNodeTemplateSelector}" />



      <controls:PersistedGridSplitter Grid.Row="1"

                    Height="6"

                    HorizontalAlignment="Stretch"

                    VerticalAlignment="Center"

                    Background="{DynamicResource Brush.Splitter}"

                    ResizeBehavior="PreviousAndNext"

                    ResizeDirection="Rows"

                    ToolTip="{loc:Text DragToResizeNeighboringPanelsYouCan}" />



      <ContentControl Grid.Row="2"

                      Content="{Binding Second}"

                      ContentTemplateSelector="{DynamicResource LayoutNodeTemplateSelector}" />

    </Grid>

  </DataTemplate>



  <shell:LayoutNodeTemplateSelector x:Key="LayoutNodeTemplateSelector"

                                    HorizontalSplit="{StaticResource PanelSplitHorizontalTemplate}"

                                    Leaf="{StaticResource PanelLeafTemplate}"

                                    VerticalSplit="{StaticResource PanelSplitVerticalTemplate}" />



</ResourceDictionary>
