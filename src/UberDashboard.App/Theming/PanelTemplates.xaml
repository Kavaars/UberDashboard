          </DataTrigger>
          <DataTrigger Binding="{Binding Owner.ColorfulTheme}" Value="True">
          <Setter Property="Foreground" Value="{Binding Owner.TemperatureCelsius, Converter={StaticResource WeatherTemperatureBrush}}"/>
          </DataTrigger>
          </Style.Triggers>
          </Style>
          </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Owner.DailyRangeText}" ToolTip="{Binding Owner.DailyRangeText}" FontSize="20" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
          <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
          <Style.Triggers>
          <DataTrigger Binding="{Binding Id}" Value="range">
          <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
          </Style.Triggers>
          </Style>
          </TextBlock.Style>
          </TextBlock>
          <Grid>
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="sunrise"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" Visibility="{Binding Owner.ShowSunrise, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{loc:Text Sunrise}" FontSize="14" Foreground="{DynamicResource Brush.Text.Muted}"/><TextBlock Text="{Binding Owner.SunriseText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="1" Visibility="{Binding Owner.ShowSunset, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{loc:Text Sunset}" FontSize="14" Foreground="{DynamicResource Brush.Text.Muted}"/><TextBlock Text="{Binding Owner.SunsetText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"/></StackPanel>
          </Grid>
          <TextBlock Text="{Binding Owner.WindText}" ToolTip="{Binding Owner.WindText}" FontSize="20" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
          <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
          <Style.Triggers>
          <DataTrigger Binding="{Binding Id}" Value="wind">
          <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
          </Style.Triggers>
          </Style>
          </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Owner.UpdatedText}" ToolTip="{Binding Owner.UpdatedText}" FontSize="20" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
          <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
          <Style.Triggers>
          <DataTrigger Binding="{Binding Id}" Value="updated">
          <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
          </Style.Triggers>
          </Style>
          </TextBlock.Style>
          </TextBlock>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
          <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
          <DataTrigger Binding="{Binding Id}" Value="forecast">
          <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
          </Style.Triggers>
          </Style>
          </ScrollViewer.Style>
          <ItemsControl ItemsSource="{Binding Owner.HourlyForecast}">
          <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
          <DataTemplate>
          <Border Margin="0,0,6,0" Padding="10,6" MinWidth="76" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" ToolTip="{Binding ConditionText}">
          <StackPanel>
          <TextBlock Text="{Binding TimeText}" FontSize="18" HorizontalAlignment="Center" FontWeight="SemiBold"/>
          <TextBlock FontSize="36" HorizontalAlignment="Center">
          <TextBlock.Style>
          <Style TargetType="TextBlock">
          <Setter Property="Text" Value="{Binding Glyph}"/>
          <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
          <Style.Triggers>
          <DataTrigger Binding="{Binding DataContext.ColorfulTheme, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
          <Setter Property="Text" Value="{Binding ColorGlyph}"/>
          <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
          </DataTrigger>
          </Style.Triggers>
          </Style>
          </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding TemperatureText}" FontSize="20" HorizontalAlignment="Center" FontWeight="SemiBold">
          <TextBlock.Style>
          <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
          <Style.Triggers>
          <DataTrigger Binding="{Binding DataContext.ColorfulTheme, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
          <Setter Property="Foreground" Value="{Binding TemperatureCelsius, Converter={StaticResource WeatherTemperatureBrush}}"/>
          </DataTrigger>
          </Style.Triggers>
          </Style>
          </TextBlock.Style>
          </TextBlock>
          </StackPanel>
          </Border>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          </StackPanel>
          </Viewbox>
          </Border>
          </Grid>
          </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>
      </controls:FitColumnsBox>
    </DockPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type shell:UnavailablePanelViewModel}">

    <TextBlock Margin="14" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Text="{Binding Message}" />

  </DataTemplate>



  <DataTemplate x:Key="PanelLeafTemplate">

    <controls:PanelAppearanceBorder Appearance="{Binding Appearance}" AutomationProperties.Name="{Binding DisplayName}">
      <controls:PanelAppearanceBorder.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{loc:Text ModuleEditMode}" ToolTip="{loc:Text ModuleEditHelp}" IsEnabled="{Binding HasModularEditing}" IsCheckable="True" IsChecked="{Binding ViewModel.IsModuleEditMode, Mode=OneWay}" Command="{Binding ToggleModuleEditCommand}"/><Separator/><MenuItem Header="{loc:Text DeletePanel}" ToolTip="{loc:Text PermanentlyDeletesThisPanelAndItsSaved}" Command="{Binding RemoveCommand}"/></ContextMenu></controls:PanelAppearanceBorder.ContextMenu>

      <controls:PanelAppearanceBorder.Style><Style TargetType="controls:PanelAppearanceBorder" BasedOn="{StaticResource PanelCard}"><Style.Triggers><DataTrigger Binding="{Binding IsSpace}" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></DataTrigger></Style.Triggers></Style></controls:PanelAppearanceBorder.Style>

      <Grid>

        <Grid.RowDefinitions>

          <RowDefinition Height="Auto" />

          <RowDefinition Height="*" />

        </Grid.RowDefinitions>




        <Popup x:Name="OptionsPopup" IsOpen="{Binding IsOptionsOpen, Mode=TwoWay}" Placement="MousePoint" AllowsTransparency="True" StaysOpen="False">

          <Border Width="360" Style="{StaticResource PanelPopupCard}">

            <DockPanel>
              <controls:PopupDragHandle Target="{Binding ElementName=OptionsPopup}" Height="16" Cursor="SizeAll" Background="{DynamicResource Brush.Surface.Alt}" DockPanel.Dock="Top" AutomationProperties.Name="{loc:Text MoveMenu}"/>
            <ScrollViewer MaxHeight="524" VerticalScrollBarVisibility="Auto">

              <StackPanel>

              <ContentControl Content="{Binding ViewModel}" ContentTemplateSelector="{StaticResource PanelOptionsSelector}" />

              <StackPanel DataContext="{Binding Appearance}" IsEnabled="{Binding IsReady}"><CheckBox Content="{loc:Text PanelShowName}" IsChecked="{Binding ShowPanelName}" Style="{StaticResource ThemedCheckBox}" ToolTip="{loc:Text PanelShowNameHelp}"/><CheckBox Content="{loc:Text PanelShowTabs}" IsChecked="{Binding ShowTabs}" Style="{StaticResource ThemedCheckBox}" ToolTip="{loc:Text PanelShowTabsHelp}"/><CheckBox Content="{loc:Text PanelLockWidth}" IsChecked="{Binding LockWidth}" Style="{StaticResource ThemedCheckBox}" ToolTip="{loc:Text PanelLockWidthHelp}"/><CheckBox Content="{loc:Text PanelLockHeight}" IsChecked="{Binding LockHeight}" Style="{StaticResource ThemedCheckBox}" ToolTip="{loc:Text PanelLockHeightHelp}"/></StackPanel>
              <Expander Header="{loc:Text Appearance}" Margin="0,12,0,0" IsExpanded="False" Foreground="{DynamicResource Brush.Text}">

              <StackPanel DataContext="{Binding Appearance}" IsEnabled="{Binding IsReady}">

                <TextBlock Text="{loc:Text ThisPanelSAppearance}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />

                <TextBlock Text="{Binding MinScale, StringFormat={loc:Text PanelMinScaleFormat}}" Margin="0,12,0,4" Foreground="{DynamicResource Brush.Text}" />
                <Slider Minimum="15" Maximum="{Binding MaxScale}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinScale}" AutomationProperties.Name="{loc:Text PanelMinScale}" ToolTip="{loc:Text PanelMinScaleHelp}" />
                <TextBlock Text="{Binding MaxScale, StringFormat={loc:Text PanelMaxScaleFormat}}" Margin="0,8,0,4" Foreground="{DynamicResource Brush.Text}" />
                <Slider Minimum="{Binding MinScale}" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxScale}" AutomationProperties.Name="{loc:Text PanelMaxScale}" ToolTip="{loc:Text PanelMaxScaleHelp}" />

                <TextBlock Text="{loc:Text BackgroundColor}" Margin="0,12,0,4" Foreground="{DynamicResource Brush.Text}" />

                <controls:CompactColorPicker SelectedColor="{Binding BackgroundColor}" AutomationProperties.Name="{loc:Text PanelBackgroundColor}" />

                <CheckBox Content="{loc:Text OverrideTextColor}" IsChecked="{Binding OverrideTextColor}" Style="{StaticResource ThemedCheckBox}" Margin="0,12,0,4" ToolTip="{loc:Text SetsATextColorForThisPanel}" />
                <controls:CompactColorPicker IsEnabled="{Binding OverrideTextColor}" SelectedColor="{Binding TextColor}" DefaultBrushKey="Brush.Text" AutomationProperties.Name="{loc:Text PanelTextColor}" ToolTip="{loc:Text ChoosesACustomTextColorForThis}" />

                <CheckBox Content="{loc:Text CustomFontAndSize}" IsChecked="{Binding CustomizeText}" Style="{StaticResource ThemedCheckBox}" Margin="0,12,0,4" />

                <TextBlock Text="{loc:Text Font}" Margin="0,12,0,4" Foreground="{DynamicResource Brush.Text}" />

                <ComboBox IsEnabled="{Binding CustomizeText}" ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily}" Style="{StaticResource ThemedComboBox}" AutomationProperties.Name="{loc:Text PanelFont}" />

                <TextBlock Text="{Binding FontSize, StringFormat={loc:Text TextSize2}}" Margin="0,12,0,4" Foreground="{DynamicResource Brush.Text}" />

                <Slider IsEnabled="{Binding CustomizeText}" Minimum="11" Maximum="24" Value="{Binding FontSize}" AutomationProperties.Name="{loc:Text PanelTextSize}" />

                <Button Content="{loc:Text ChooseWallpaper}" Margin="0,12,0,0" Command="{Binding ChooseWallpaperCommand}" Style="{StaticResource ToolbarButton}" />

                <TextBlock Text="{Binding WallpaperPath}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Muted}" />

                <TextBlock Text="{loc:Text WallpaperVisibility}" Margin="0,12,0,4" Foreground="{DynamicResource Brush.Text}" />

                <Slider Minimum="0" Maximum="1" Value="{Binding WallpaperOpacity}" AutomationProperties.Name="{loc:Text PanelWallpaperVisibility}" />

                <WrapPanel Margin="0,12,0,0">

                  <Button Content="{loc:Text DefaultAppearance}" Command="{Binding ResetCommand}" Style="{StaticResource PanelActionButton}" />

                  <Button Content="{loc:Text RetrySave}" Command="{Binding RetrySaveCommand}" Style="{StaticResource PanelActionButton}" />

                </WrapPanel>

                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Muted}" />

              </StackPanel></Expander></StackPanel>

            </ScrollViewer>
            </DockPanel>

          </Border>

        </Popup>

        <Border Grid.Row="0" controls:PanelDragDrop.IsHandle="True"

                Background="Transparent"

                BorderBrush="{DynamicResource Brush.Border}"

                BorderThickness="0"

                CornerRadius="{DynamicResource Token.CornerRadius.L}"

                Padding="{DynamicResource Token.Padding.ControlSmall}"

                ToolTip="{loc:Text PanelHeaderWithFormattingOptionsAndLayout}"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSpace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding TabSession.IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Border.Style>

          <DockPanel>

            <WrapPanel DockPanel.Dock="Right" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=controls:PanelAppearanceBorder}, Converter={StaticResource PanelHeaderWidth}}">

              <Button AutomationProperties.Name="{loc:Text TextFormatting}" Command="{Binding ToggleFormattingCommand}"

                      Content="&#xE8D2;"

                      ToolTip="{loc:Text ShowsOrHidesTheFormattingToolbarFor}"

                      Visibility="{Binding HasFormatting, Converter={StaticResource BoolToVisibility}}">

                <Button.Style>

                  <Style TargetType="Button" BasedOn="{StaticResource PanelActionGlyphButton}">

                    <Style.Triggers>

                      <DataTrigger Binding="{Binding IsFormattingVisible}" Value="True">

                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />

                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />

                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />

                      </DataTrigger>

                    </Style.Triggers>

                  </Style>

                </Button.Style>

              </Button>

              <Button Command="{Binding RefreshCommand}" Content="&#xE72C;" AutomationProperties.Name="{loc:Text Refresh}" ToolTip="{loc:Text PanelRefreshHelp}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PanelActionGlyphButton}"><Style.Triggers><DataTrigger Binding="{Binding RefreshCommand}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
              </Button>
              <Button AutomationProperties.Name="{loc:Text PanelOptions}" Command="{Binding ToggleOptionsCommand}"

                      Content="&#xE712;"

                      ToolTip="{loc:Text ShowsOrHidesThisPanelSFloating}"

                      Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">

                <Button.Style>

                  <Style TargetType="Button" BasedOn="{StaticResource PanelActionGlyphButton}">

                    <Style.Triggers>

                      <DataTrigger Binding="{Binding IsOptionsOpen}" Value="True">

                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />

                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />

                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />

                      </DataTrigger>

                    </Style.Triggers>

                  </Style>

                </Button.Style>

              </Button>


              <Button AutomationProperties.Name="{loc:Text SwapPanels}" Command="{Binding DataContext.SwapPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                      CommandParameter="{Binding}"

                      Content="&#xE8AB;"

                      Style="{StaticResource PanelActionGlyphButton}"

                      ToolTip="{loc:Text SelectsThisPanelToSwapPositionsWith}"

                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />

              <Button AutomationProperties.Name="{loc:Text HidePanel}" Command="{Binding DataContext.HidePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                      CommandParameter="{Binding}"

                      Content="&#xE8F4;"

                      Style="{StaticResource PanelActionGlyphButton}"

                      ToolTip="{loc:Text HidesThisPanelAndKeepsItsData}"

                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />

              <Button AutomationProperties.Name="{loc:Text DeletePanel}" Command="{Binding DataContext.RemovePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                      CommandParameter="{Binding}"

                      Content="&#xE74D;"

                      Style="{StaticResource PanelActionGlyphButton}"

                      ToolTip="{loc:Text PermanentlyDeletesThisPanelAndItsSaved}"

                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />

            </WrapPanel>



            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">

              <Border Width="28"

                      Height="28"

                      Margin="0,0,8,0"

                      Background="{DynamicResource Brush.Surface}"

                      BorderBrush="{DynamicResource Brush.Border}"

                      BorderThickness="1"

                      CornerRadius="{DynamicResource Token.CornerRadius.S}">

                <TextBlock HorizontalAlignment="Center"

                           VerticalAlignment="Center"

                           FontFamily="Segoe MDL2 Assets"

                           FontSize="14"

                           Foreground="{DynamicResource Brush.Accent}"

                           Text="{Binding IconGlyph}" />

              </Border>

              <TextBlock VerticalAlignment="Center"

                         FontWeight="SemiBold"

                         Foreground="{DynamicResource Brush.Text}"

                         Text="{Binding DisplayName}"

                         Visibility="{Binding Appearance.ShowPanelName, Converter={StaticResource BoolToVisibility}}"

                         TextTrimming="CharacterEllipsis"

                         ToolTip="{loc:Text InEditModeDragThisTitleTo}" />

              <Ellipse Width="7"

                       Height="7"

                       Margin="6,0,0,0"

                       VerticalAlignment="Center"

                       Fill="{DynamicResource Brush.Warning}"

                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"

                       ToolTip="{loc:Text ThisPanelHasChangesWaitingToBe}" />

            </StackPanel>
            <controls:PanelGroupTabStrip Session="{Binding TabSession}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding Appearance.ShowTabs, Converter={StaticResource BoolToVisibility}}" />

          </DockPanel>

        </Border>



        <controls:PanelResizeThumb Grid.RowSpan="2" Edge="Left" Width="8" HorizontalAlignment="Left" Cursor="SizeWE" Panel.ZIndex="30" Visibility="{Binding IsEditablePanel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Text ResizePanelOnGrid}" ToolTip="{loc:Text ResizePanelOnGridHelp}" />
        <controls:PanelResizeThumb Grid.RowSpan="2" Edge="Right" Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Panel.ZIndex="30" Visibility="{Binding IsEditablePanel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Text ResizePanelOnGrid}" ToolTip="{loc:Text ResizePanelOnGridHelp}" />
        <controls:PanelResizeThumb Grid.RowSpan="2" Edge="Top" Height="8" VerticalAlignment="Top" Cursor="SizeNS" Panel.ZIndex="30" Visibility="{Binding IsEditablePanel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Text ResizePanelOnGrid}" ToolTip="{loc:Text ResizePanelOnGridHelp}" />
        <controls:PanelResizeThumb Grid.RowSpan="2" Edge="Bottom" Height="8" VerticalAlignment="Bottom" Cursor="SizeNS" Panel.ZIndex="30" Visibility="{Binding IsEditablePanel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Text ResizePanelOnGrid}" ToolTip="{loc:Text ResizePanelOnGridHelp}" />

        <Grid x:Name="PanelContentArea" Grid.Row="1" ClipToBounds="True"><Image Source="{Binding Appearance.Wallpaper}" Opacity="{Binding Appearance.WallpaperOpacity}" Stretch="UniformToFill" IsHitTestVisible="False" /><DockPanel><controls:ResponsivePanelContent Content="{Binding PanelContent}"><controls:ResponsivePanelContent.LayoutTransform><MultiBinding Converter="{StaticResource PanelScaleConverter}"><Binding ElementName="PanelContentArea" Path="ActualWidth"/><Binding ElementName="PanelContentArea" Path="ActualHeight"/><Binding Path="Appearance.MinScale"/><Binding Path="Appearance.MaxScale"/></MultiBinding></controls:ResponsivePanelContent.LayoutTransform><controls:ResponsivePanelContent.Style><Style TargetType="controls:ResponsivePanelContent"><Style.Triggers><DataTrigger Binding="{Binding TabSession.IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></controls:ResponsivePanelContent.Style></controls:ResponsivePanelContent></DockPanel><Border VerticalAlignment="Bottom" Background="{DynamicResource Brush.Popup}" Padding="8,3" Visibility="{Binding TabSession.IsBusy, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{loc:Text SwitchingTabs}" Foreground="{DynamicResource Brush.Text}" /></Border></Grid>
        <Border Grid.Row="1" Panel.ZIndex="20" Background="Transparent" Cursor="SizeAll" controls:PanelDragDrop.IsHandle="True" Visibility="{Binding IsEditablePanel, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Text MovePanelOnGridHelp}" />


      </Grid>

    </controls:PanelAppearanceBorder>

  </DataTemplate>



  </ResourceDictionary>
