<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tokeny motywu jasnego. Kontrast tekstu i tekstu pomocniczego >= 4.5:1. -->
  <SolidColorBrush x:Key="Brush.Window.Background" Color="#FFF3F2EE" />
  <SolidColorBrush x:Key="Brush.Panel.DefaultText" Color="#FF000000" />
  <SolidColorBrush x:Key="Brush.Popup" Color="#FFFDFCF9" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFDFCF9" />
  <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#FFEAECE5" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FF29342E" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#FF59665D" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FFDCE1D9" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#FF607D6A" />
  <SolidColorBrush x:Key="Brush.Accent.Text" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#FFC42B1C" />
  <SolidColorBrush x:Key="Brush.Success" Color="#FF107C10" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#FF9A6700" />
  <SolidColorBrush x:Key="Brush.Splitter" Color="#FFDCE1D9" />
  <SolidColorBrush x:Key="Brush.Badge.Background" Color="#FF202124" />
  <SolidColorBrush x:Key="Brush.Badge.Text" Color="#FFFFFFFF" />

</ResourceDictionary>
