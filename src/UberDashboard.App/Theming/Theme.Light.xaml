<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tokeny motywu jasnego. Kontrast tekstu i tekstu pomocniczego >= 4.5:1. -->
  <SolidColorBrush x:Key="Brush.Window.Background" Color="#FFF6F7F9" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#FFEFF1F4" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FF1B1D21" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#FF565C64" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FFD5D9DF" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#FF1668C1" />
  <SolidColorBrush x:Key="Brush.Accent.Text" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#FFC42B1C" />
  <SolidColorBrush x:Key="Brush.Success" Color="#FF107C10" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#FF9A6700" />
  <SolidColorBrush x:Key="Brush.Splitter" Color="#FFC2C7CE" />
  <SolidColorBrush x:Key="Brush.Badge.Background" Color="#FF202124" />
  <SolidColorBrush x:Key="Brush.Badge.Text" Color="#FFFFFFFF" />

</ResourceDictionary>
