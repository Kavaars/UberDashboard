<Application x:Class="UberDashboard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Kolejność: na indeksie 0 ThemeService wstawia aktywny słownik motywu
          (Theme.Light.xaml albo Theme.Dark.xaml). Style i szablony korzystają z
          tokenów motywu przez DynamicResource, więc zmiana motywu działa w czasie
          rzeczywistym bez ponownego ładowania widoków.
        -->
        <ResourceDictionary Source="Theming/Theme.Light.xaml" />
        <ResourceDictionary Source="Theming/VisualTokens.xaml" />
        <ResourceDictionary Source="Theming/Controls.xaml" />
        <ResourceDictionary Source="Theming/WindowFrame.xaml" />
        <ResourceDictionary Source="Theming/PanelTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
