<UserControl x:Class="UberDashboard.App.Features.HomeAssistant.HomeAssistantView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:UberDashboard.App.Features.HomeAssistant"
 xmlns:loc="clr-namespace:UberDashboard.App.Localization"
 xmlns:controls="clr-namespace:UberDashboard.App.Controls">
 <UserControl.Resources>
  <DataTemplate x:Key="HomeAssistantModuleCard">
   <Border CornerRadius="8" Padding="8" Background="{DynamicResource Brush.Surface.Alt}"
    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
    <Border.ContextMenu>
     <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="{loc:Text HomeAssistantRemoveModule}" Command="{Binding RemoveModuleCommand}"
       CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
     </ContextMenu>
    </Border.ContextMenu>
    <Grid>
     <StackPanel VerticalAlignment="Center">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
       <DataTrigger Binding="{Binding IsAction}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Value}" FontSize="20" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
     </StackPanel>
     <Button Content="{Binding Label}" Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
      CommandParameter="{Binding}" Visibility="Collapsed">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding IsAction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers></Style></Button.Style>
     </Button>
    </Grid>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <DockPanel>
  <WrapPanel DockPanel.Dock="Top">
   <Button Content="{loc:Text HomeAssistantAddModule}" Command="{Binding AddModuleCommand}" Style="{StaticResource ToolbarButton}"/>
   <Button Content="{loc:Text HomeAssistantConnection}" Command="{Binding OpenConnectionCommand}" Style="{StaticResource ToolbarButton}"/>
  </WrapPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="3,5,0,0"/>
  <Grid>
   <TextBlock Text="{loc:Text HomeAssistantEmpty}" TextWrapping="Wrap" Margin="10" Foreground="{DynamicResource Brush.Text.Muted}" IsHitTestVisible="False">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
     <DataTrigger Binding="{Binding Modules.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <ListBox ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource HomeAssistantModuleCard}"
    controls:ModuleReorderBehavior.Managed="True" controls:ModuleReorderBehavior.Enabled="{Binding IsModuleEditMode}"
    Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    AutomationProperties.Name="{loc:Text HomeAssistant}" AutomationProperties.HelpText="{loc:Text ModuleKeyboardHelp}" ToolTip="{loc:Text ModuleKeyboardHelp}">
    <ListBox.ItemsPanel><ItemsPanelTemplate>
     <controls:ModularItemsPanel Spacing="{Binding ModuleSpacing}" CellWidth="120" CellHeight="72" AutoCellHeight="True"/>
    </ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
     </Style>
    </ListBox.ItemContainerStyle>
   </ListBox>
  </Grid>
 </DockPanel>
</UserControl>
